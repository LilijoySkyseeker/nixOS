#!/usr/bin/env bash
# gate-mutants -- measure whether scripts/gate-tests can detect the defects it
# claims to guard, by reintroducing them one at a time and requiring the named
# case to go red.
#
# gate-tests counts its own assertions and nothing counts gate-tests. The two
# numbers are independent: 102 assertions passed in the same session in which
# six mutations, each restoring a defect the branch had just fixed, passed the
# harness 98 of 98 -- including the one for a regression fixed two commits
# earlier. Every genuine finding across three sessions came from a person
# mutating code by hand and watching what happened. This is that, written down
# and executed.
# plan: 2026-09-07-revise-the-plan-file-schema-state-first-four-frontmatter-fields.md#G12
# plan: 2026-09-07-revise-the-plan-file-schema-state-first-four-frontmatter-fields.md#F35
#
# A catalogue entry is a claim with three parts -- target file, mutation, and
# the gate-tests case that must go red -- and each part can be wrong on its
# own, so each is checked separately rather than folded into one pass/fail:
#
#   UNKNOWN-CASE  the named case does not appear in a clean run at all. A
#                 renamed or deleted case would otherwise turn its entry into
#                 a permanent silent escape, which is the same defect class
#                 the catalogue exists to find.
#   INERT         the mutation left the file byte-identical. A sed that
#                 matches nothing produces an unmutated run, and an entry that
#                 measures nothing must not be reported as measuring
#                 something.
#   BROKEN        the mutant did not run to completion. A mutation that
#                 introduces a syntax error fails cases for a reason that has
#                 nothing to do with the defect, and would otherwise be
#                 counted as a catch.
#   ESCAPED       the mutation applied, the suite ran, and the named case
#                 still passed. This is the finding.
#   CAUGHT        the named case went red.
#
# Cost is roughly N x the suite, so this stays out of verify-ladder's
# pre-commit path and runs as checks.gate-mutants under `nix flake check`.
# plan: 2026-09-07-revise-the-plan-file-schema-state-first-four-frontmatter-fields.md#D2
# plan: 2026-09-07-revise-the-plan-file-schema-state-first-four-frontmatter-fields.md#G8
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"

# The suite is relocatable: it derives every path from its own location and
# builds its own git fixture, so a tree holding just these two things runs it
# to the same verdict. That is what makes mutation possible at all -- the
# alternative is mutating the working copy, which loses the user's edits if
# anything goes wrong.
TREE_PATHS=(scripts/gate-tests docs/skills/plan docs/skills/workflow .githooks)

# ------------------------------------------------------------- mutation verbs

# All four operate on $f (the copy under mutation) and match *literal* text,
# never a regex. Anchors are copied verbatim out of the target, so a mutation
# that stops matching after a refactor reports INERT rather than quietly
# measuring nothing. Values reach awk through the environment, not -v: awk
# expands escape sequences in a -v assignment, so an anchor containing a
# literal backslash-n -- which several of these do -- would arrive as a
# newline and match nothing.
# `cp` into the existing file, never `mv` onto it: mv replaces the inode and
# the mutant loses its executable bit, so every mutation of a gate script
# became "the script cannot be run" instead of the defect it names. Six
# entries reported CAUGHT on that -- the meta-test passing for a reason it did
# not name, which is the shape it exists to find.
# plan: 2026-09-07-revise-the-plan-file-schema-state-first-four-frontmatter-fields.md#G12
mut_write() { cp "$1" "$f" && rm -f "$1"; }

mut_subst() { # <literal-old> <literal-new> [which-occurrence, default 1]
  MUT_OLD="$1" MUT_NEW="$2" MUT_N="${3:-1}" awk '
    BEGIN { old = ENVIRON["MUT_OLD"]; new = ENVIRON["MUT_NEW"]; want = ENVIRON["MUT_N"] + 0 }
    {
      line = $0; out = ""
      while ((i = index(line, old)) > 0) {
        seen++
        out = out substr(line, 1, i - 1) (seen == want ? new : old)
        line = substr(line, i + length(old))
      }
      print out line
    }' "$f" > "$f.mut" && mut_write "$f.mut"
}

mut_delline() { # <literal> -- drop every line containing it
  MUT_PAT="$1" awk 'BEGIN { p = ENVIRON["MUT_PAT"] } index($0, p) == 0' "$f" > "$f.mut" &&
    mut_write "$f.mut"
}

mut_delblock() { # <start-literal> <end-literal> -- drop the first block, inclusive
  MUT_S="$1" MUT_E="$2" awk '
    BEGIN { s = ENVIRON["MUT_S"]; e = ENVIRON["MUT_E"] }
    !done && !inblock && index($0, s) { inblock = 1; next }
    inblock { if (index($0, e)) { inblock = 0; done = 1 } next }
    { print }' "$f" > "$f.mut" && mut_write "$f.mut"
}

mut_insert_before() { # <literal-anchor> <text>
  MUT_A="$1" MUT_T="$2" awk '
    BEGIN { a = ENVIRON["MUT_A"]; t = ENVIRON["MUT_T"] }
    !done && index($0, a) { print t; done = 1 }
    { print }' "$f" > "$f.mut" && mut_write "$f.mut"
}

# ------------------------------------------------------------------ catalogue

US=$'\037'
catalogue=()
mutant() { # <id> <target-rel-path> <mutation-code> <case that must go red>...
  local rec="$1$US$2$US$3" c
  shift 3
  for c in "$@"; do rec+="$US$c"; done
  catalogue+=("$rec")
}

LIB=docs/skills/plan/scripts/lib.sh
LINT=docs/skills/plan/scripts/plan-lint
CITE=docs/skills/plan/scripts/plan-citations
REPAIR=docs/skills/plan/scripts/plan-repair
FREEZE=docs/skills/plan/scripts/plan-freeze
REJECT=docs/skills/plan/scripts/plan-reject
MOVE=docs/skills/plan/scripts/plan-move
STAMP=docs/skills/workflow/scripts/subagent-stamp
PRECOMMIT=.githooks/pre-commit
GATE=docs/skills/workflow/scripts/plan-gate
AGENTS=docs/skills/workflow/scripts/required-agents

# --- lib.sh: the readers every gate shares -----------------------------------

mutant lib/frontmatter-first-wins "$LIB" \
  'mut_delline "if (k in seen) next"' \
  "both frontmatter readers agree on a duplicated key"

mutant lib/field-refs-drops-last "$LIB" \
  'mut_subst "printf '"'"'%s\n'"'"' \"\$raw\" | tr" "printf '"'"'%s'"'"' \"\$raw\" | tr"' \
  "plan-lint checks the last entry of a reference list"

mutant lib/headings-fence-blind "$LIB" \
  'mut_subst "!fence && /^## / { print FNR" "/^## / { print FNR"' \
  "plan-lint does not count sections quoted inside a fence" \
  "plan-lint passes a plan that quotes the template inside State"

mutant lib/active-plan-problem-silent "$LIB" \
  'mut_subst "  [ -s \"\$marker\" ] || return 0" "  return 0"' \
  "a marker naming a deleted plan is a problem"

# Occurrence 2: this close rule appears verbatim in plan_headings, in
# plan_state_body and again in plan-repair, and an unnumbered anchor mutates
# the first -- a different function from the one the entry names, which read
# as an escape until the site was checked.
mutant lib/state-body-fence-toggle "$LIB" \
  'mut_subst "else if (substr(m, 1, 1) == substr(open, 1, 1) && length(m) >= length(open)) fence = 0" "else fence = 0" 2' \
  "nested fence, odd count"

mutant lib/rung-unanchored "$LIB" \
  'mut_subst "/^verified to rung [1-5]" "/verified to rung [1-5]"' \
  "negated" "a denial stays refused at any wrap" "a denial survives any decoration"

mutant lib/rung-trailing-word-allowed "$LIB" \
  'mut_subst "^verified to rung [1-5]( ?[^0-9a-z ].*)?\$/" "^verified to rung [1-5].*\$/"' \
  "subject position" "a subject-position mention stays refused"

mutant lib/rung-keeps-emphasis "$LIB" \
  'mut_delline "gsub(/[*_]/, \"\", b)"' \
  "bold" "a declaration survives any decoration"

mutant lib/rung-reads-fences "$LIB" \
  'mut_subst "plan_state_body \"\$1\" skip-fences |" "plan_state_body \"\$1\" |"' \
  "fenced example, inside" "quoting the phrase never declares it"

mutant lib/manifest-frozen-unanchored "$LIB" \
  'mut_subst "{ i = index(\$0, \"  \"); if (i > 0 && substr(\$0, i + 2) == want) { found = 1; exit } }" "{ if (index(\$0, want) > 0) { found = 1; exit } }"' \
  "a plan is not frozen because a longer path begins with its path"

# The other direction of the same reader. Without it a plan_manifest_frozen
# that answers "no" to everything satisfies the three path cases above, which
# are all negative.
mutant lib/manifest-frozen-always-false "$LIB" \
  'mut_subst "END { exit(found ? 0 : 1) }" "END { exit 1 }"' \
  "plan-repair adds the missing section and re-records the checksum"

mutant lib/record-checksum-loose-path "$LIB" \
  'mut_subst "{ i = index(\$0, \"  \"); if (i > 0 && substr(\$0, i + 2) == want) next }" "{ if (index(\$0, want) > 0) next }"' \
  "recording one path leaves an entry that merely begins with it alone"

mutant lib/record-checksum-unnormalised "$LIB" \
  'mut_subst "rel=\"\$(plan_normalise_rel \"\$2\")\"" "rel=\"\$2\"" 2' \
  "the same file spelled two ways gets one manifest entry"

# --- plan-lint ---------------------------------------------------------------

mutant plan-lint/frozen-is-self-declared "$LINT" \
  'mut_subst "if plan_manifest_frozen \"\$root\" \"\$rel\"; then" "if plan_is_frozen \"\$file\"; then"' \
  "plan-lint still applies the schema rules to a self-declared frozen plan"

mutant plan-lint/no-self-freeze-warning "$LINT" \
  'mut_subst "[ \"\$frozen_field\" != \"true\" ] ||" "true ||"' \
  "plan-lint reports a plan that declares itself frozen"

mutant plan-lint/no-missing-section-check "$LINT" \
  'mut_subst "[ -n \"\${sec_line[\$section]:-}\" ] || report" "true || report"' \
  "plan-lint does not count sections quoted inside a fence" \
  "plan-freeze refuses a malformed plan, because freezing makes it permanent" \
  "plan-reject refuses a malformed plan"

mutant plan-lint/no-section-order-check "$LINT" \
  'mut_subst "[ \"\$line\" -gt \"\$prev_line\" ] ||" "true ||"' \
  "plan-lint reports required sections that appear out of order"

mutant plan-lint/no-ref-shape-check "$LINT" \
  'mut_subst "[[ \"\$ref\" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*\\.md\$ ]] ||" "true ||"' \
  "plan-lint checks the last entry of a reference list"

# --- the two doors to freeze -------------------------------------------------

mutant plan-freeze/frozen-is-self-declared "$FREEZE" \
  'mut_subst "plan_manifest_frozen \"\$root\" \"\$rel\" &&" "plan_is_frozen \"\$root/\$rel\" &&"' \
  "plan-freeze refuses a plan the manifest already records"

mutant plan-freeze/no-lint-gate "$FREEZE" \
  'mut_delblock "if ! lint_out=\"\$(\"\$SCRIPT_DIR/plan-lint\"" "fi"' \
  "plan-freeze refuses a malformed plan, because freezing makes it permanent"

mutant plan-reject/no-lint-gate "$REJECT" \
  'mut_delblock "if ! lint_out=\"\$(\"\$SCRIPT_DIR/plan-lint\"" "fi"' \
  "plan-reject refuses a malformed plan"

# The #F31 defect exactly: the gate still runs and still refuses, but only
# after the marker, the move and the status rewrite, so the refusal strands
# the plan in rejected/ half-stamped. A case keyed on the refusal alone stays
# green; only one that checks where the file ended up can see this.
mutant plan-reject/gate-after-move "$REJECT" \
  'mut_delblock "if ! lint_out=\"\$(\"\$SCRIPT_DIR/plan-lint\"" "fi"
   mut_insert_before "plan_do_freeze \"\$root\" \"\$new_rel\"" "if ! lint_out=\"\$(\"\$SCRIPT_DIR/plan-lint\" \"\$new_rel\" 2>&1)\"; then
  plan_die \"cannot reject -- \$new_rel is malformed, and freezing makes that permanent:
\$lint_out\"
fi"' \
  "a refused rejection leaves the plan untouched"

mutant plan-reject/unchecked-git-mv "$REJECT" \
  'mut_subst "git -C \"\$root\" mv \"\$rel\" \"\$new_rel\" ||" "git -C \"\$root\" mv \"\$rel\" \"\$new_rel\" || true ||"' \
  "plan-reject refuses when the move fails, rather than freezing the destination" \
  "a failed move freezes nothing at the destination"

# --- plan-repair: the one script allowed to write into a frozen file ---------

mutant plan-repair/no-op-write "$REPAIR" \
  'mut_subst "FNR == at { print; print \"\"; print sec;" "FNR == -1 { print; print \"\"; print sec;"' \
  "plan-repair adds the missing section and re-records the checksum"

mutant plan-repair/insertion-point-moved "$REPAIR" \
  'mut_subst "!fence && /^# / { print FNR; exit }" "!fence && /^## Progress/ { print FNR; exit }"' \
  "plan-repair adds the missing section and re-records the checksum"

mutant plan-repair/no-checksum-rerecord "$REPAIR" \
  'mut_delline "plan_record_checksum \"\$root\" \"\$rel\""' \
  "plan-repair adds the missing section and re-records the checksum"

mutant plan-repair/no-checksum-precondition "$REPAIR" \
  'mut_subst "[ \"\$recorded\" = \"\$(plan_checksum \"\$file\")\" ] ||" "true ||"' \
  "plan-repair refuses a frozen file that no longer matches its checksum"

mutant plan-repair/no-frozen-precondition "$REPAIR" \
  'mut_subst "plan_manifest_frozen \"\$root\" \"\$rel\" ||" "true ||"' \
  "plan-repair refuses a plan that is not frozen"

mutant plan-repair/no-already-has-guard "$REPAIR" \
  'mut_subst "plan_headings \"\$file\" | cut -f2- | grep -qxF \"\$missing\" &&" "false &&"' \
  "plan-repair refuses to touch a section that already exists"

mutant plan-repair/title-matcher-fence-blind "$REPAIR" \
  'mut_subst "!fence && /^# / { print FNR; exit }" "/^# / { print FNR; exit }"' \
  "plan-repair adds the missing section and re-records the checksum"

# --- plan-citations ----------------------------------------------------------

mutant plan-citations/pathform-skips-resolution "$CITE" \
  'mut_subst "      # no \`continue\`: the citation still has to resolve below" "      continue"' \
  "a muted path-form citation in a frozen plan is still resolved"

mutant plan-citations/no-pathform-report "$CITE" \
  'mut_subst "        report \"\${a#./}: cites" "        : \"\${a#./}: cites"' \
  "plan-citations refuses a plan cited by path"

# --- plan-gate and required-agents -------------------------------------------

mutant plan-gate/no-ref-check "$GATE" \
  'mut_subst "git rev-parse --verify --quiet \"\$r^{commit}\" >/dev/null ||" "true ||"' \
  "plan-gate refuses an unresolvable base ref"

mutant plan-gate/log-failure-swallowed "$GATE" \
  'mut_subst "if ! plans=\"\$(git log" "plans=\"\$(git log"
   mut_subst "| sort -u)\"; then" "| sort -u)\"; if false; then"' \
  "plan-gate over a real range"

mutant plan-gate/no-stampable-floor "$GATE" \
  'mut_subst "if [ \"\${#obliged_agents[@]}\" -gt 0 ] && [ \"\$any_stampable\" -eq 0 ]; then" "if false; then"' \
  "plan-gate refuses when no obliged agent is stampable"

mutant plan-gate/no-missing-stamp-report "$GATE" \
  'mut_subst "    stamp_problem \"\$rel cites a range that changed files obliging" "    : \"\$rel cites a range that changed files obliging"' \
  "plan-gate refuses a range whose plan is unstamped"

mutant required-agents/no-diff-check "$AGENTS" \
  'mut_subst "if ! changed=\"\$(git -c core.quotePath=false diff --name-only \"\${1}...\${2:-HEAD}\")\"; then" "changed=\"\$(git -c core.quotePath=false diff --name-only \"\${1}...\${2:-HEAD}\")\"; if false; then"' \
  "required-agents refuses an unresolvable range"

mutant required-agents/no-order-check "$AGENTS" \
  'mut_subst "  plan_in_list \"\$a\" \"\${emitted[@]}\" ||" "  true ||"' \
  "required-agents refuses an agent missing from the order"

# The sabotage shim is a fake `git` on PATH, so it is blind to a gate that
# resolves the binary itself. That property is asserted on the source rather
# than through the shim, and this is the mutation that must trip it.
# plan: 2026-09-06-harden-the-workflow-system-against-the-failure-classes-it-exposed.md#F14
mutant required-agents/absolute-git "$AGENTS" \
  'mut_subst "git -c core.quotePath=false diff --name-only" "\"\$(command -v git)\" -c core.quotePath=false diff --name-only"' \
  "every git the swept gates invoke is resolved through PATH"

# --- the gates that write, swept with a fresh fixture per iteration ---------

# plan-move as it was: plan_repo_root and plan_locate both end in plan_die,
# but they are called in a command substitution, where plan_die exits the
# subshell and leaves the caller running with an empty root -- and neither
# the mv nor the stage was checked either. Every guard goes at once, because
# the sweep asserts the contract ("it refuses") and not which line refused:
# strip only one and a later guard still refuses, so the mutation is
# equivalent and escapes. That is the correct outcome for a contract-level
# test, and the reason this entry is written at the contract's granularity.
mutant plan-move/fails-open-without-its-guards "$MOVE" \
  'mut_subst "root=\"\$(plan_repo_root)\" || exit 1" "root=\"\$(plan_repo_root)\""
   mut_subst "rel=\"\$(plan_locate \"\$arg\" \"\$root\")\" || exit 1" "rel=\"\$(plan_locate \"\$arg\" \"\$root\")\""
   mut_subst "git -C \"\$root\" mv \"\$rel\" \"\$new_rel\" ||" "git -C \"\$root\" mv \"\$rel\" \"\$new_rel\" || true ||"
   mut_subst "git -C \"\$root\" add \"\$new_rel\" ||" "git -C \"\$root\" add \"\$new_rel\" || true ||"' \
  "plan-move into in-progress" "plan-move into done, which execs plan-freeze"

mutant plan-move/unchecked-git-add "$MOVE" \
  'mut_subst "git -C \"\$root\" add \"\$new_rel\" ||" "git -C \"\$root\" add \"\$new_rel\" || true ||"' \
  "plan-move into in-progress"

mutant lib/record-checksum-unchecked-add "$LIB" \
  'mut_subst "git -C \"\$root\" add \"\$rel\" \"\$PLAN_CHECKSUMS_RELPATH\" ||" "git -C \"\$root\" add \"\$rel\" \"\$PLAN_CHECKSUMS_RELPATH\" || true ||"' \
  "plan-move into done, which execs plan-freeze"

mutant pre-commit/manifest-read-swallowed "$PRECOMMIT" \
  'mut_subst "  0) manifest=\"\$(git show '"'"':docs/plans/.checksums'"'"')\" ;;" "  0) manifest=\"\$(git show '"'"':docs/plans/.checksums'"'"' 2>/dev/null || true)\" ;;"
   mut_subst "git ls-files --error-unmatch -- docs/plans/.checksums >/dev/null 2>&1 || ls_rc=\$?" "ls_rc=0"' \
  ".githooks/pre-commit"

mutant pre-commit/gitlink-probe-unchecked "$PRECOMMIT" \
  'mut_subst "  if ! mode=\"\$(git ls-files -s -- \"\$file\")\"; then" "  mode=\"\$(git ls-files -s -- \"\$file\" || true)\"; if false; then"' \
  ".githooks/pre-commit"

mutant pre-commit/binary-probe-unchecked "$PRECOMMIT" \
  'mut_subst "  if ! git show \":\$file\" > \"\$blob\"; then" "  git show \":\$file\" > \"\$blob\" || true; if false; then"' \
  ".githooks/pre-commit"

# The residue is an assertion too: if subagent-stamp stops failing silently,
# the reason it is exempt from the sweep is gone and the note must go red.
mutant subagent-stamp/no-longer-fail-silent "$STAMP" \
  'mut_subst "git -C \"\$root\" add \"\$rel\" 2>/dev/null || true" "git -C \"\$root\" add \"\$rel\""' \
  "subagent-stamp is exempt from the sabotage sweep"

# --- the freeze manifest, which is the only evidence frozen plans carry ------

# `sort ... > "$checksums"` truncates the manifest before sort runs, so one
# failed step emptied it for every frozen plan at once, and the checked
# `git add` then staged the empty file and exited 0.
mutant lib/manifest-write-not-atomic "$LIB" \
  'mut_subst "sort -k2 \"\$tmp\" > \"\$out\" ||" "sort -k2 \"\$tmp\" > \"\$checksums\"; true ||"' \
  "a failed manifest rewrite leaves the manifest intact"

mutant lib/manifest-may-shrink "$LIB" \
  'mut_subst "if [ \"\$(grep -c . \"\$out\")\" -lt \"\$(grep -c . \"\$checksums\")\" ]; then" "if false; then"
   mut_subst "sort -k2 \"\$tmp\" > \"\$out\" ||" "sort -k2 \"\$tmp\" > \"\$out\"; : ||"' \
  "a failed manifest rewrite leaves the manifest intact"

# The last enforcement point that trusted the file's own `frozen:` field.
mutant lib/require-not-frozen-trusts-the-field "$LIB" \
  'mut_subst "  plan_manifest_frozen \"\$root\" \"\$rel\" &&" "  false &&"' \
  "a manifest-frozen plan is refused even when its own field says otherwise"

# No entry for the `[ -s "$manifest" ]` guard on its own: with it removed an
# empty manifest still reports a problem, because GNU `sha256sum -c` exits 1
# on a file with no checksum lines rather than passing vacuously. The guard
# is defence in depth and a clearer message, not the load-bearing check, so a
# mutation of it is equivalent and would escape by construction.
# plan: 2026-09-07-revise-the-plan-file-schema-state-first-four-frontmatter-fields.md#F57
mutant lib/manifest-problem-ignores-mismatch "$LIB" \
  'mut_subst "  [ -z \"\$bad\" ] ||" "  true ||"' \
  "a frozen plan that no longer matches its hash is a problem"

mutant pre-commit/manifest-deletion-unnoticed "$PRECOMMIT" \
  'mut_subst "    staged_manifest_delete=\"\$(git diff --cached --name-only --diff-filter=D -- docs/plans/.checksums)\"" "    staged_manifest_delete=\"\""' \
  ".githooks/pre-commit refuses a staged deletion of the freeze manifest"

# ------------------------------------------------------------------- machinery

build_tree() { # <dest>
  local dest="$1" p
  for p in "${TREE_PATHS[@]}"; do
    mkdir -p "$dest/$(dirname "$p")"
    cp -r "$REPO_ROOT/$p" "$dest/$(dirname "$p")/"
  done
}

# gate-tests prints `  ok    NAME`, `  known NAME -- why` and `  FAIL  NAME`,
# and a failing case may carry a parenthesised qualifier its passing form does
# not ("NAME (baseline)"). Matching on the bare name would then miss a real
# red, so the qualifier is stripped here rather than in each comparison.
case_names() { # <verdict: ok|FAIL|any> -- reads a run's output on stdin
  MUT_WANT="$1" awk '
    BEGIN { want = ENVIRON["MUT_WANT"] }
    /^  ok    / { v = "ok"; n = substr($0, 9) }
    /^  known / { v = "ok"; n = substr($0, 9); sub(/ -- .*$/, "", n) }
    /^  FAIL  / { v = "FAIL"; n = substr($0, 9); sub(/ \([^()]*\)$/, "", n) }
    n != "" { if (want == "any" || want == v) print n; n = ""; v = "" }
  '
}

run_suite() { # <tree> -- prints the run output, sets nothing
  ( cd "$1" && ./scripts/gate-tests 2>&1 )
}

# --run-one is how the parent parallelises: the catalogue is built above, so a
# re-exec of this script has it, and each mutant gets a private tree.
if [ "${1:-}" = "--run-one" ]; then
  idx="$2" pristine="$3"
  # -d '': a mutation body may be several lines, and a plain `read` stops at
  # the first newline -- which silently truncated the record and dropped every
  # case name after it, so two entries reported CAUGHT while asserting nothing.
  # The meta-test had the defect it exists to find.
  IFS="$US" read -r -d '' -a rec < <(printf '%s\0' "${catalogue[$idx]}")
  id="${rec[0]}" target="${rec[1]}" code="${rec[2]}"
  expect=("${rec[@]:3}")
  work="$(mktemp -d)" || { printf '%s\t%s\tBROKEN\tcannot create a scratch tree\n' "$idx" "$id"; exit 0; }
  trap 'rm -rf "$work"' EXIT
  cp -r "$pristine/." "$work/"
  f="$work/$target"
  eval "$code" >/dev/null 2>&1
  # A mutation must change the file's text and nothing else about it. A verb
  # that also changed the mode would make every entry it touches fail for
  # "cannot execute", which reads as a catch.
  if [ -x "$pristine/$target" ] && [ ! -x "$work/$target" ]; then
    printf '%s\t%s\tBROKEN\tthe mutation cleared the executable bit on %s\n' "$idx" "$id" "$target"
    exit 0
  fi
  # Still a valid script. A mutation that introduces a syntax error fails
  # cases because the file cannot be parsed, which is not the defect it names
  # -- and if one of those cases happens to be the named one, it reads as a
  # catch. Checked here rather than inferred from how many cases went red.
  if head -n 1 "$work/$target" | grep -q '^#!.*bash' && ! bash -n "$work/$target" 2>/dev/null; then
    printf '%s\t%s\tBROKEN\tthe mutation left %s syntactically invalid\n' "$idx" "$id" "$target"
    exit 0
  fi
  if cmp -s "$pristine/$target" "$work/$target"; then
    printf '%s\t%s\tINERT\tthe mutation matched nothing in %s; its anchor has drifted\n' "$idx" "$id" "$target"
    exit 0
  fi
  out="$(run_suite "$work")"
  if ! printf '%s' "$out" | grep -q '^gate-tests: [0-9]* passed'; then
    printf '%s\t%s\tBROKEN\tthe mutant did not run to completion: %s\n' \
      "$idx" "$id" "$(printf '%s' "$out" | tail -n 1)"
    exit 0
  fi
  reds="$(printf '%s\n' "$out" | case_names FAIL)"
  # Every case the run printed, residues included -- so this is gate-tests'
  # "passed" plus its "recorded residue(s)", and is deliberately larger than
  # the passed count alone. A residue is an assertion like any other here:
  # a mutation can turn one red.
  total="$(printf '%s\n' "$out" | case_names any | grep -c .)"
  nred="$(printf '%s' "$reds" | grep -c .)"
  missed=""
  for c in "${expect[@]}"; do
    printf '%s\n' "$reds" | grep -qxF -- "$c" || missed+="${missed:+; }$c"
  done
  # A mutation that reddens a quarter of the suite has almost certainly broken
  # something other than the property under test, and would then be a catch
  # for the wrong reason -- the meta-test's own version of the defect it hunts.
  noisy=""
  [ "$total" -gt 0 ] && [ $((nred * 4)) -gt "$total" ] &&
    noisy=" [noisy: $nred of $total cases red]"
  if [ -n "$missed" ]; then
    printf '%s\t%s\tESCAPED\tno case went red for: %s (%s of %s red)%s\n' "$idx" "$id" "$missed" "$nred" "$total" "$noisy"
  else
    printf '%s\t%s\tCAUGHT\t%s case(s), %s of %s red%s\n' "$idx" "$id" "${#expect[@]}" "$nred" "$total" "$noisy"
  fi
  exit 0
fi

jobs="$(nproc 2>/dev/null || echo 4)"
only=""
while [ $# -gt 0 ]; do
  case "$1" in
    --jobs) jobs="$2"; shift 2 ;;
    --only) only="$2"; shift 2 ;;
    --list)
      for rec in "${catalogue[@]}"; do
        IFS="$US" read -r -d '' -a r < <(printf '%s\0' "$rec")
        printf '%-44s %s\n' "${r[0]}" "${r[1]}"
      done
      exit 0 ;;
    *) printf 'usage: gate-mutants [--jobs N] [--only <id-substring>] [--list]\n' >&2; exit 1 ;;
  esac
done

scratch="$(mktemp -d)" || { printf 'gate-mutants: cannot create a scratch directory\n' >&2; exit 1; }
[ -n "$scratch" ] && [ -d "$scratch" ] || { printf 'gate-mutants: scratch directory is not usable\n' >&2; exit 1; }
trap 'rm -rf "$scratch"' EXIT
pristine="$scratch/pristine"
build_tree "$pristine"

# The positive control for the whole run. Every verdict below is "this case
# went red under mutation"; against an already-red suite that is unreadable,
# and a suite that fails to run at all would report every mutation CAUGHT.
printf 'gate-mutants: baseline ... '
base_out="$(run_suite "$pristine")"
if ! printf '%s' "$base_out" | grep -q '^gate-tests: [0-9]* passed, 0 failed'; then
  printf 'not green\n%s\n' "$(printf '%s' "$base_out" | tail -n 20)" >&2
  printf 'gate-mutants: refusing to measure a suite that is not passing.\n' >&2
  exit 1
fi
mapfile -t observable < <(printf '%s\n' "$base_out" | case_names any)
printf '%s cases observable\n\n' "${#observable[@]}"

# Every named case must exist before any mutant runs. A renamed case would
# otherwise never be found red, which is indistinguishable from an escape.
indices=() unknown=0
for i in "${!catalogue[@]}"; do
  IFS="$US" read -r -d '' -a r < <(printf '%s\0' "${catalogue[$i]}")
  [ -z "$only" ] || case "${r[0]}" in *"$only"*) ;; *) continue ;; esac
  # An entry naming no case is a claim about nothing. Reported here rather
  # than left to the worker, which would print CAUGHT over an empty
  # expectation -- passing because it asserted nothing.
  if [ "${#r[@]}" -le 3 ]; then
    printf '  NO-CASE       %-40s names no case that must go red\n' "${r[0]}" >&2
    unknown=$((unknown + 1))
    continue
  fi
  for c in "${r[@]:3}"; do
    printf '%s\n' "${observable[@]}" | grep -qxF -- "$c" && continue
    printf '  UNKNOWN-CASE  %-40s names a case no clean run prints: %s\n' "${r[0]}" "$c" >&2
    unknown=$((unknown + 1))
  done
  indices+=("$i")
done
[ "$unknown" -eq 0 ] || printf '\n'

[ "${#indices[@]}" -gt 0 ] || { printf 'gate-mutants: no catalogue entry matched.\n' >&2; exit 1; }

results="$(printf '%s\n' "${indices[@]}" |
  xargs -P "$jobs" -I{} "$SCRIPT_DIR/gate-mutants" --run-one {} "$pristine" |
  sort -n)"

caught=0 escaped=0 inert=0 broken=0
while IFS=$'\t' read -r _idx id verdict detail; do
  [ -n "${verdict:-}" ] || continue
  case "$verdict" in
    CAUGHT)  caught=$((caught + 1));  printf '  caught   %-44s %s\n' "$id" "$detail" ;;
    ESCAPED) escaped=$((escaped + 1)); printf '  ESCAPED  %-44s %s\n' "$id" "$detail" >&2 ;;
    INERT)   inert=$((inert + 1));    printf '  INERT    %-44s %s\n' "$id" "$detail" >&2 ;;
    BROKEN)  broken=$((broken + 1));  printf '  BROKEN   %-44s %s\n' "$id" "$detail" >&2 ;;
  esac
done <<< "$results"

printf '\ngate-mutants: %s caught, %s escaped, %s inert, %s broken, %s unknown case(s)\n' \
  "$caught" "$escaped" "$inert" "$broken" "$unknown"
[ "$escaped" -eq 0 ] && [ "$inert" -eq 0 ] && [ "$broken" -eq 0 ] && [ "$unknown" -eq 0 ]
