#!/usr/bin/env bash
# gate-tests -- failure-mode tests for required-agents and the git hooks:
# point each at a broken environment and require it to refuse rather than
# report success over a check it could not make. Read-only against this
# repo; every case builds a scratch repository under $TMPDIR.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
WORKFLOW_SCRIPTS="$SCRIPT_DIR/../docs/skills/workflow/scripts"

# a caller's GIT_DIR (from a hook or `rebase --exec`) or env-supplied
# config would point the fixture's git calls at the real repository
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_CEILING_DIRECTORIES GIT_COMMON_DIR \
  GIT_TEMPLATE_DIR GIT_NAMESPACE GIT_ATTR_NOSYSTEM GIT_CONFIG_COUNT
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null

pass=0 fail=0 known=0
scratch="$(mktemp -d)" || { printf 'gate-tests: cannot create a scratch directory\n' >&2; exit 1; }
[ -n "$scratch" ] && [ -d "$scratch" ] || { printf 'gate-tests: scratch directory is not usable\n' >&2; exit 1; }
trap 'rm -rf "$scratch"' EXIT

ok()   { pass=$((pass + 1)); printf '  ok    %s\n' "$1"; }
bad()  { fail=$((fail + 1)); printf '  FAIL  %s\n    %s\n' "$1" "$2" >&2; }
note() { known=$((known + 1)); printf '  known %s -- %s\n' "$1" "$2"; }
section() { printf '\n== %s ==\n' "$1"; }

# asserts a fixture can reach the failure the next case names
precondition() { # <name> <command...>
  local name="$1"
  shift
  if "$@" >/dev/null 2>&1; then ok "$name"
  else bad "$name" "the case that follows cannot reach the failure it names"; fi
}

# <name> <expected-stderr-fragment> <command...>
expect_fail() {
  local name="$1" want="$2" out rc
  shift 2
  out="$("$@" 2>&1)"; rc=$?
  if [ "$rc" -eq 0 ]; then
    bad "$name" "exited 0; it should have refused"
  elif [ -n "$want" ] && ! printf '%s' "$out" | grep -qF -- "$want"; then
    bad "$name" "refused, but not for the stated reason: $(printf '%s' "$out" | tail -n 1)"
  else
    ok "$name"
  fi
}

expect_rc() { # <name> <want-rc> <command...>
  local name="$1" want="$2" rc
  shift 2
  "$@" >/dev/null 2>&1; rc=$?
  [ "$rc" -eq "$want" ] && ok "$name" || bad "$name" "exited $rc, want $want"
}

new_repo() { # <dir>
  mkdir -p "$1"
  git -C "$1" init -q
  git -C "$1" config user.email t@t
  git -C "$1" config user.name t
  git -C "$1" config commit.gpgsign false
  git -C "$1" config core.hooksPath /dev/null
}

section "required-agents fails closed"

repo="$scratch/repo"
new_repo "$repo"
mkdir -p "$repo/docs/skills"
cp -r "$WORKFLOW_SCRIPTS/.." "$repo/docs/skills/workflow"
printf '# note\n' > "$repo/docs/note.md"
git -C "$repo" add -A >/dev/null
git -C "$repo" commit -qm base
printf '{ }\n' > "$repo/a.nix"
git -C "$repo" add a.nix >/dev/null
git -C "$repo" commit -qm "code change"

expect_fail "required-agents refuses an unresolvable range" "cannot diff" \
  env -C "$repo" "$repo/docs/skills/workflow/scripts/required-agents" nosuchref HEAD
# `declare -F` first, so a renamed helper exits 3 rather than passing
expect_rc "wf_worktree_files refuses a broken GIT_DIR" 1 \
  env -C "$repo" GIT_DIR=/nonexistent bash -c \
  '. docs/skills/workflow/scripts/lib.sh; declare -F wf_worktree_files >/dev/null || exit 3; wf_worktree_files "*.nix"'
expect_fail "required-agents refuses an agent missing from the order" "missing from WF_AGENT_ORDER" \
  env -C "$repo" bash -c '
    sed -i "s/WF_AGENT_ORDER=(\"\/simplify\" \"security\" \"docs-updater\")/WF_AGENT_ORDER=(\"\/simplify\" \"docs-updater\")/" docs/skills/workflow/scripts/lib.sh
    docs/skills/workflow/scripts/required-agents HEAD~1 HEAD'
git -C "$repo" checkout -q -- docs/skills/workflow/scripts/lib.sh

section "awkward filenames still oblige review"
obliges_security() { # <filename>
  local name="$1" out
  ( cd "$repo" && printf '{ }\n' > "$name" ) 2>/dev/null || return 2
  out="$(env -C "$repo" "$repo/docs/skills/workflow/scripts/required-agents" 2>/dev/null)"
  ( cd "$repo" && rm -f -- "$name" )
  printf '%s' "$out" | grep -qx security
}
if obliges_security "$(printf 'caf\303\251.nix')"; then
  ok "a non-ASCII .nix name obliges review"
else
  bad "a non-ASCII .nix name obliges review" "required-agents did not name security"
fi
if obliges_security 'quo"te.nix'; then
  note "a quoted .nix name obliges review" "core.quotePath=false does not demote a literal quote; this passing is the better outcome"
else
  note "a quoted .nix name obliges NO review" "recorded residue: git C-quotes it regardless of core.quotePath"
fi

section "sabotage: no gate may report success when a git call underneath it failed"

real_git="$(command -v git)"
fakebin="$scratch/fakebin"
mkdir -p "$fakebin"
{
  # $BASH: there is no /usr/bin/env in a build sandbox
  printf '#!%s\n' "$BASH"
  printf 'c=0; read -r c < "$SABOTAGE_COUNT" 2>/dev/null\n'
  printf 'c=$((c + 1)); printf %%s "$c" > "$SABOTAGE_COUNT"\n'
  printf 'if [ "$c" = "$SABOTAGE_AT" ]; then echo "sabotage: git call $c" >&2; exit 128; fi\n'
  printf 'exec %s "$@"\n' "$real_git"
} > "$fakebin/git"
chmod +x "$fakebin/git"

# the shim only sees a git resolved through PATH
path_git_violations=""
for _f in "$WORKFLOW_SCRIPTS/lib.sh" "$WORKFLOW_SCRIPTS/required-agents"; do
  _hits="$(sed 's/#.*//' "$_f" |
    grep -nE '(/git([[:space:]]|$|")|command -v git|which git|\$\{?GIT\}?[^A-Z_])')" || continue
  path_git_violations+="${_f##*/}:$(printf '%s' "$_hits" | tr '\n' ' ') "
done
if [ -z "$path_git_violations" ]; then
  ok "every git the swept gates invoke is resolved through PATH"
else
  bad "every git the swept gates invoke is resolved through PATH" \
    "the sabotage shim cannot see these calls: $path_git_violations"
fi

# function run before the baseline and every iteration, for gates that write
SWEEP_RESET=""

sabotage_sweep() { # <name> <success-fragment> <max-calls> <command...>
  local name="$1" want="$2" max="$3" n out rc leaked="" base_out base_count seen_calls
  shift 3
  [ -z "$SWEEP_RESET" ] || "$SWEEP_RESET"
  printf 0 > "$scratch/sabotage.count"
  base_out="$(PATH="$fakebin:$PATH" SABOTAGE_COUNT="$scratch/sabotage.count" SABOTAGE_AT=0 "$@" 2>&1)"
  rc=$?
  base_count=0; read -r base_count < "$scratch/sabotage.count" 2>/dev/null
  if [ "$rc" -ne 0 ]; then
    bad "$name" "the gate already refuses with nothing sabotaged; the sweep would prove nothing"
    return
  fi
  if [ -n "$want" ] && ! printf '%s' "$base_out" | grep -qF -- "$want"; then
    bad "$name" "the gate exited 0 without doing its work: $(printf '%s' "$base_out" | tail -n 1)"
    return
  fi
  if [ "$base_count" -eq 0 ]; then
    bad "$name" "the gate made no git call through the shim; the sweep would sabotage nothing"
    return
  fi
  for ((n = 1; n <= max; n++)); do
    [ -z "$SWEEP_RESET" ] || "$SWEEP_RESET"
    printf 0 > "$scratch/sabotage.count"
    out="$(PATH="$fakebin:$PATH" SABOTAGE_COUNT="$scratch/sabotage.count" SABOTAGE_AT="$n" "$@" 2>&1)"
    rc=$?
    seen_calls=0; read -r seen_calls < "$scratch/sabotage.count" 2>/dev/null
    [ "$seen_calls" -lt "$n" ] && break
    if [ "$rc" -eq 0 ]; then
      leaked="$n"
      printf '    (call %s failed; gate still exited 0 saying: %s)\n' "$n" "$(printf '%s' "$out" | tail -n 1)" >&2
      break
    fi
  done
  if [ -n "$leaked" ]; then
    bad "$name" "reported success with git call $leaked sabotaged"
  elif [ "$base_count" -gt "$max" ]; then
    bad "$name" "made $base_count git calls but max is $max; the calls past $max were never sabotaged"
  else
    ok "$name"
  fi
}

sabotage_sweep "required-agents over a real range" "security" 25 \
  env -C "$repo" "$repo/docs/skills/workflow/scripts/required-agents" HEAD~1 HEAD
# a dirty doc, so the working-tree form obliges someone
printf '\nsweep fodder\n' >> "$repo/docs/note.md"
sabotage_sweep "required-agents over the working tree" "docs-updater" 25 \
  env -C "$repo" "$repo/docs/skills/workflow/scripts/required-agents"
git -C "$repo" checkout -q -- docs/note.md

mrepo="$scratch/mrepo"
mpristine="$scratch/mrepo-pristine"
new_repo "$mpristine"
cp -r "$SCRIPT_DIR/../.githooks" "$mpristine/.githooks"
printf '# base\n' > "$mpristine/README.md"
git -C "$mpristine" add -A >/dev/null
git -C "$mpristine" commit -qm base
# staged, so pre-commit has something to scan instead of exiting early
printf '{ }\n' > "$mpristine/staged.nix"
git -C "$mpristine" add staged.nix >/dev/null
mreset() { rm -rf "$mrepo"; cp -a "$mpristine" "$mrepo"; }

SWEEP_RESET=mreset
mreset
precondition "the pre-commit fixture has something staged, so the hook cannot exit early" \
  env -C "$mrepo" bash -c '[ -n "$(git diff --cached --name-only)" ]'
sabotage_sweep ".githooks/pre-commit" "" 30 \
  env -C "$mrepo" bash "$mrepo/.githooks/pre-commit"
SWEEP_RESET=""

section "pre-push decides what to build, and must not decide it from a failed range"
pp_bin="$scratch/ppbin"; mkdir -p "$pp_bin"
for stub in nix nixos-rebuild; do
  { printf '#!%s\n' "$BASH"; printf 'printf "%%s\\n" "$0" >> "$PP_RAN"\nexit 0\n'; } > "$pp_bin/$stub"
  chmod +x "$pp_bin/$stub"
done
pp_run() { # <local-sha> <remote-sha> -- prints the hook's rc, records stub calls
  : > "$scratch/pp.ran"
  printf 'refs/heads/x %s refs/heads/x %s\n' "$1" "$2" |
    env -C "$mrepo" PATH="$pp_bin:$PATH" PP_RAN="$scratch/pp.ran" \
    bash "$mrepo/.githooks/pre-push" >/dev/null 2>&1
  printf '%s' "$?"
}
mreset
mkdir -p "$mrepo/hosts/testhost" "$mrepo/modules"
printf '{ }\n' > "$mrepo/hosts/testhost/configuration.nix"
git -C "$mrepo" add hosts >/dev/null 2>&1
git -C "$mrepo" commit -qm host >/dev/null 2>&1
printf '{ }\n' > "$mrepo/modules/probe.nix"
git -C "$mrepo" add modules >/dev/null 2>&1
git -C "$mrepo" commit -qm second >/dev/null 2>&1
pp_head="$(git -C "$mrepo" rev-parse HEAD)"
pp_prev="$(git -C "$mrepo" rev-parse HEAD~1)"
precondition "the pre-push fixture has a modules/ file in its range, so a build is owed" \
  env -C "$mrepo" bash -c 'git diff --name-only HEAD~1 HEAD -- modules/ | grep -q .'
pp_rc="$(pp_run "$pp_head" "$pp_prev")"
if [ "$pp_rc" = 0 ] && grep -q . "$scratch/pp.ran"; then
  ok "pre-push reaches its build over an ordinary range"
else
  bad "pre-push reaches its build over an ordinary range" \
    "rc=$pp_rc and the stubs were invoked $(grep -c . "$scratch/pp.ran") time(s)"
fi
# no origin/master in the fixture, so the merge base cannot be computed
pp_rc="$(pp_run "$pp_head" "0000000000000000000000000000000000000000")"
if [ "$pp_rc" != 0 ] || grep -q . "$scratch/pp.ran"; then
  ok "pre-push does not skip its build when the merge base cannot be computed"
else
  bad "pre-push does not skip its build when the merge base cannot be computed" \
    "it exited 0 having built nothing; the range collapsed to a working-tree diff"
fi

printf '\ngate-tests: %s passed, %s failed, %s recorded residue(s)\n' "$pass" "$fail" "$known"
[ "$fail" -eq 0 ] || exit 1
