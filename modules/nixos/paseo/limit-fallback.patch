diff --git a/packages/server/src/server/agent/agent-manager.test.ts b/packages/server/src/server/agent/agent-manager.test.ts
index 44e38a344..195856419 100644
--- a/packages/server/src/server/agent/agent-manager.test.ts
+++ b/packages/server/src/server/agent/agent-manager.test.ts
@@ -11892,3 +11892,85 @@ test.each([false, true])(
     }
   },
 );
+
+function createLimitFallbackManager() {
+  const workdir = mkdtempSync(join(tmpdir(), "agent-manager-test-"));
+  const storage = new AgentStorage(join(workdir, "agents"), logger);
+  const subscription = new TestAgentClient("claude");
+  const credits = new TestAgentClient("claude-api-credits");
+  const manager = new AgentManager({
+    clients: { claude: subscription, "claude-api-credits": credits, codex: new TestAgentClient() },
+    providerDefinitions: {
+      claude: { enabled: true },
+      "claude-api-credits": { enabled: true, derivedFromProviderId: "claude", limitFallback: true },
+      codex: { enabled: true },
+    },
+    registry: storage,
+    logger,
+  });
+  const limitClaudeUntil = (resetsAt: string) =>
+    (manager as unknown as { recordProviderLimit(p: string, l: { resetsAt: string }): void })
+      .recordProviderLimit("claude", { resetsAt });
+  return { workdir, manager, credits, limitClaudeUntil };
+}
+
+test("switchAgentProvider moves an idle agent between profiles of one provider in place", async () => {
+  const { workdir, manager, credits } = createLimitFallbackManager();
+  const agent = await manager.createAgent({ provider: "claude", cwd: workdir }, undefined, {
+    workspaceId: undefined,
+  });
+  const until = "2026-11-02T00:00:00.000Z";
+
+  const moved = await manager.switchAgentProvider(agent.id, "claude-api-credits", {
+    fallbackUntil: until,
+  });
+  expect(moved.id).toBe(agent.id);
+  expect(moved.provider).toBe("claude-api-credits");
+  expect(moved.labels["paseo.limit-fallback"]).toBe(until);
+  expect(credits.resumeOverrides).toHaveLength(1);
+
+  expect(manager.getAgent(agent.id)?.labels["paseo.limit-fallback"]).toBe(until);
+
+  await manager.switchAgentProvider(agent.id, "claude");
+  expect(manager.getAgent(agent.id)?.provider).toBe("claude");
+  expect(manager.getAgent(agent.id)?.labels["paseo.limit-fallback"]).toBeUndefined();
+});
+
+test("switchAgentProvider refuses a provider that is not a profile of the same base", async () => {
+  const { workdir, manager } = createLimitFallbackManager();
+  const agent = await manager.createAgent({ provider: "claude", cwd: workdir }, undefined, {
+    workspaceId: undefined,
+  });
+  await expect(manager.switchAgentProvider(agent.id, "codex")).rejects.toThrow(
+    "unrelated provider",
+  );
+  expect(manager.getAgent(agent.id)?.provider).toBe("claude");
+});
+
+test("new chats start on the limit fallback until the limit resets, then move back", async () => {
+  const { workdir, manager, limitClaudeUntil } = createLimitFallbackManager();
+  const resetsAt = new Date(Date.now() + 60 * 60_000).toISOString();
+  limitClaudeUntil(resetsAt);
+
+  const agent = await manager.createAgent({ provider: "claude", cwd: workdir }, undefined, {
+    workspaceId: undefined,
+  });
+  expect(agent.provider).toBe("claude-api-credits");
+  expect(agent.labels["paseo.limit-fallback"]).toBe(resetsAt);
+
+  await manager.restoreDueLimitFallbacks(Date.parse(resetsAt) - 1);
+  expect(manager.getAgent(agent.id)?.provider).toBe("claude-api-credits");
+
+  await manager.restoreDueLimitFallbacks(Date.parse(resetsAt) + 1);
+  expect(manager.getAgent(agent.id)?.provider).toBe("claude");
+  expect(manager.getAgent(agent.id)?.labels["paseo.limit-fallback"]).toBeUndefined();
+});
+
+test("chats are not moved to the fallback once the limit has passed", async () => {
+  const { workdir, manager, limitClaudeUntil } = createLimitFallbackManager();
+  limitClaudeUntil(new Date(Date.now() - 1000).toISOString());
+  const agent = await manager.createAgent({ provider: "claude", cwd: workdir }, undefined, {
+    workspaceId: undefined,
+  });
+  expect(agent.provider).toBe("claude");
+});
