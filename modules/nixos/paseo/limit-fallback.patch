new file mode 100644
index 000000000..fa50686dc
--- /dev/null
+++ b/packages/server/src/server/agent/credit-ledger.test.ts
@@ -0,0 +1,37 @@
+import { mkdtempSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { expect, test } from "vitest";
+import { creditCycle } from "@getpaseo/protocol/agent-usage-limit";
+import { createTestLogger } from "../../test-utils/test-logger.js";
+import { CreditLedger } from "./credit-ledger.js";
+
+const budget = { monthlyUsd: 100, cycleDay: 2 };
+
+function ledgerPath() {
+  return join(mkdtempSync(join(tmpdir(), "credit-ledger-")), "credit-ledger.jsonl");
+}
+
+test("metered spend is the increase in the session's running cost, and survives a restart", () => {
+  const path = ledgerPath();
+  const ledger = new CreditLedger(path, createTestLogger());
+  // Subscription turns set the baseline without counting as spend.
+  ledger.record({ agentId: "a", provider: "claude", sessionTotalUsd: 0.5, metered: false });
+  ledger.record({ agentId: "a", provider: "credits", sessionTotalUsd: 0.53, metered: true });
+  ledger.record({ agentId: "a", provider: "credits", sessionTotalUsd: 0.6, metered: true });
+  ledger.record({ agentId: "b", provider: "credits", sessionTotalUsd: 0.02, metered: true });
+
+  for (const current of [ledger, new CreditLedger(path, createTestLogger())]) {
+    const spend = current.spend("a", "credits", budget);
+    expect(spend.chatUsd).toBeCloseTo(0.1);
+    expect(spend.cycleUsd).toBeCloseTo(0.12);
+    expect(spend.budgetUsd).toBe(100);
+  }
+});
+
+test("the cycle renews on its day of the month", () => {
+  const { start, end } = creditCycle(new Date(2026, 10, 1, 12), 2);
+  expect(start).toEqual(new Date(2026, 9, 2));
+  expect(end).toEqual(new Date(2026, 10, 2));
+  expect(creditCycle(new Date(2026, 10, 2, 0, 1), 2).start).toEqual(new Date(2026, 10, 2));
+});
diff --git a/packages/server/src/server/agent/credit-ledger.ts b/packages/server/src/server/agent/credit-ledger.ts
new file mode 100644
index 000000000..26e8bd55b
--- /dev/null
+++ b/packages/server/src/server/agent/credit-ledger.ts
@@ -0,0 +1,90 @@
+import { appendFileSync, readFileSync } from "node:fs";
+import type { Logger } from "pino";
+import {
+  creditCycle,
+  type CreditBudget,
+  type CreditSpend,
+} from "@getpaseo/protocol/agent-usage-limit";
+
+interface LedgerLine {
+  at: string;
+  agentId: string;
+  provider: string;
+  // The provider session's running cost total; spend is its increase on a metered provider.
+  sessionTotalUsd: number;
+  usd: number;
+}
+
+/**
+ * Estimated spend on metered (API-billed) profiles, from the running session cost a
+ * provider reports after each turn. Append-only JSONL, replayed at startup.
+ */
+export class CreditLedger {
+  private readonly baselines = new Map<string, number>();
+  private readonly chatUsd = new Map<string, number>();
+  private readonly spends: Array<{ at: number; provider: string; usd: number }> = [];
+
+  constructor(
+    private readonly path: string,
+    private readonly logger: Logger,
+  ) {
+    let text = "";
+    try {
+      text = readFileSync(path, "utf8");
+    } catch {
+      return; // no spend recorded yet
+    }
+    for (const raw of text.split("\n")) {
+      if (!raw) continue;
+      try {
+        this.apply(JSON.parse(raw) as LedgerLine);
+      } catch {
+        this.logger.warn({ path }, "Skipping an unreadable credit ledger line");
+      }
+    }
+  }
+
+  record(input: { agentId: string; provider: string; sessionTotalUsd: number; metered: boolean }) {
+    const baseline = this.baselines.get(input.agentId);
+    if (baseline === input.sessionTotalUsd) return;
+    // A lower total is a new provider session: its whole total is new spend.
+    const delta =
+      baseline === undefined || input.sessionTotalUsd < baseline
+        ? input.sessionTotalUsd
+        : input.sessionTotalUsd - baseline;
+    const line: LedgerLine = {
+      at: new Date().toISOString(),
+      agentId: input.agentId,
+      provider: input.provider,
+      sessionTotalUsd: input.sessionTotalUsd,
+      usd: input.metered ? delta : 0,
+    };
+    this.apply(line);
+    try {
+      appendFileSync(this.path, `${JSON.stringify(line)}\n`);
+    } catch (error) {
+      this.logger.warn({ err: error, path: this.path }, "Failed to append to the credit ledger");
+    }
+  }
+
+  spend(agentId: string, provider: string, budget: CreditBudget, now = new Date()): CreditSpend {
+    const cycle = creditCycle(now, budget.cycleDay);
+    let cycleUsd = 0;
+    for (const entry of this.spends) {
+      if (entry.provider === provider && entry.at >= cycle.start.getTime()) cycleUsd += entry.usd;
+    }
+    return {
+      chatUsd: this.chatUsd.get(agentId) ?? 0,
+      cycleUsd,
+      budgetUsd: budget.monthlyUsd,
+      cycleEndsAt: cycle.end.toISOString(),
+    };
+  }
+
+  private apply(line: LedgerLine) {
+    this.baselines.set(line.agentId, line.sessionTotalUsd);
+    if (line.usd <= 0) return;
+    this.chatUsd.set(line.agentId, (this.chatUsd.get(line.agentId) ?? 0) + line.usd);
+    this.spends.push({ at: Date.parse(line.at), provider: line.provider, usd: line.usd });
+  }
+}
