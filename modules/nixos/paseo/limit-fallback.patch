+export type CreditBudget = z.infer<typeof CreditBudgetSchema>;
+
+// Estimated from the cost each turn reports; the provider's billing page is authoritative.
+export const CreditSpendSchema = z.object({
+  chatUsd: z.number(),
+  cycleUsd: z.number(),
+  budgetUsd: z.number(),
+  cycleEndsAt: z.string(),
+});
+
+export type CreditSpend = z.infer<typeof CreditSpendSchema>;
+
+export function creditCycle(now: Date, cycleDay: number): { start: Date; end: Date } {
+  const start = new Date(now.getFullYear(), now.getMonth(), cycleDay);
+  if (start > now) start.setMonth(start.getMonth() - 1);
+  const end = new Date(start);
+  end.setMonth(end.getMonth() + 1);
+  return { start, end };
+}
