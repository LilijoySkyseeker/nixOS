 export const USAGE_LIMIT_RESUME_DELAY_MS = 60_000;
+// On an agent moved to a limit-fallback profile: when to move it back (ISO), or "unknown".
+export const LIMIT_FALLBACK_LABEL = "paseo.limit-fallback";
 
 export const AgentUsageLimitSchema = z.object({
   resetsAt: z.string().nullable(),
@@ -9,8 +11,40 @@ export const AgentUsageLimitSchema = z.object({
 
 export type AgentUsageLimit = z.infer<typeof AgentUsageLimitSchema>;
 
+// On unless a chat opts out: an unattended chat should pick up where it stopped.
+export function autoResumesUsageLimit(labels: Record<string, string> | undefined): boolean {
+  return labels?.[AUTO_RESUME_USAGE_LIMIT_LABEL] !== "false";
+}
+
 export function usageLimitResumeAt(limit: AgentUsageLimit): number | null {
   if (limit.resetsAt === null) return null;
   const resetsAt = Date.parse(limit.resetsAt);
