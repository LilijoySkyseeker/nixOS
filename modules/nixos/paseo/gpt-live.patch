+import { describe, expect, it } from "vitest";
+import { isTurnTrigger } from "@/agent-stream/turn-membership";
+import type { StreamItem } from "@/types/stream";
+import { handoffText, isVoiceHandoff, readSpokenTurn } from "./spoken-turns";
+
+function spoken(data: unknown): StreamItem {
+  return {
+    kind: "plugin",
+    id: "paseo-voice/t1",
+    pluginId: "paseo-voice",
+    pluginItemId: "t1",
+    itemKind: "spoken_turn",
+    version: 1,
+    data: data as never,
+    timestamp: new Date(1),
+  };
+}
+
+describe("spoken turns", () => {
+  it("reads a spoken turn and rejects other entries", () => {
+    expect(readSpokenTurn(spoken({ speaker: "user", text: "Hi" }))).toEqual({
+      speaker: "user",
+      text: "Hi",
+    });
+    expect(readSpokenTurn(spoken({ speaker: "robot", text: "Hi" }))).toBeNull();
+    expect(
+      readSpokenTurn({
+        ...spoken({ speaker: "user", text: "Hi" }),
+        pluginId: "x",
+      } as StreamItem),
+    ).toBeNull();
+  });
+
+  it("starts a turn when the user speaks, not when the voice does", () => {
+    expect(isTurnTrigger(spoken({ speaker: "user", text: "Hi" }))).toBe(true);
+    expect(isTurnTrigger(spoken({ speaker: "voice", text: "Hi" }))).toBe(false);
+  });
+
+  it("recognises the hand-off message", () => {
+    const handoff: StreamItem = {
+      kind: "user_message",
+      id: "m1",
+      clientMessageId: "voice-handoff:1",
+      text: "Check the build",
+      timestamp: new Date(1),
+    };
+    expect(isVoiceHandoff(handoff)).toBe(true);
+    expect(isVoiceHandoff({ ...handoff, clientMessageId: "typed-1" })).toBe(false);
+    // Threads from earlier builds marked the text instead.
+    const legacy = { ...handoff, clientMessageId: undefined, text: "(spoken) Check the build" };
+    expect(isVoiceHandoff(legacy)).toBe(true);
+    expect(handoffText(legacy.text)).toBe("Check the build");
+  });
+});
