diff --git a/packages/app/src/screens/settings/voice/live-voice-rows.tsx b/packages/app/src/screens/settings/voice/live-voice-rows.tsx
new file mode 100644
index 000000000..4bf2ed21e
--- /dev/null
+++ b/packages/app/src/screens/settings/voice/live-voice-rows.tsx
@@ -0,0 +1,166 @@
+import { useCallback, useMemo } from "react";
+import { useTranslation } from "react-i18next";
+import { SettingsRow } from "@/components/settings";
+import { SegmentedControl } from "@/components/ui/segmented-control";
+import { SelectField, type SelectFieldOption } from "@/components/ui/select-field";
+
+// Rows for voice mode on GPT-Live. The daemon applies both settings: the quiet close to open
+// sessions, the voice to the next session.
+
+// Matches the daemon's defaults when the host has no setting.
+export const DEFAULT_QUIET_CLOSE_SECONDS = 60;
+export const DEFAULT_LIVE_VOICE = "marin";
+export const DEFAULT_WHILE_AGENT_WORKS = "keep_open";
+
+const WHILE_AGENT_WORKS_CHOICES = ["keep_open", "reopen", "close"] as const;
+type WhileAgentWorksChoice = (typeof WHILE_AGENT_WORKS_CHOICES)[number];
+
+const QUIET_CLOSE_CHOICES = ["0", "30", "60", "120", "300"] as const;
+type QuietCloseChoice = (typeof QUIET_CLOSE_CHOICES)[number];
+
+// gpt-live-1 voices, checked against the API on 2026-11-01. Accents and other languages are
+// GPT-Live's additional voices; the rest are OpenAI's standard voices.
+const LIVE_VOICES: Array<{ id: string; label: string; description?: string }> = [
+  { id: "marin", label: "Marin" },
+  { id: "cedar", label: "Cedar" },
+  { id: "alloy", label: "Alloy" },
+  { id: "ash", label: "Ash" },
+  { id: "ballad", label: "Ballad" },
+  { id: "coral", label: "Coral" },
+  { id: "echo", label: "Echo" },
+  { id: "sage", label: "Sage" },
+  { id: "shimmer", label: "Shimmer" },
+  { id: "verse", label: "Verse" },
+  { id: "gleam", label: "Gleam", description: "North American, feminine" },
+  { id: "meridian", label: "Meridian", description: "North American, masculine" },
+  { id: "vesper", label: "Vesper", description: "British, masculine" },
+  { id: "willow", label: "Willow", description: "Irish, feminine" },
+  { id: "stone", label: "Stone", description: "Irish, masculine" },
+  { id: "quartz", label: "Quartz", description: "Australian, feminine" },
+  { id: "ripple", label: "Ripple", description: "Australian, masculine" },
+  { id: "delta", label: "Delta", description: "Southern U.S., feminine" },
+  { id: "cinder", label: "Cinder", description: "Southern U.S., masculine" },
+  { id: "beacon", label: "Beacon", description: "Filipino English, masculine" },
+  { id: "bossa", label: "Bossa", description: "Brazilian Portuguese, feminine" },
+  { id: "tempo", label: "Tempo", description: "Brazilian Portuguese, masculine" },
+  { id: "nuri", label: "Nuri", description: "German, feminine" },
+  { id: "juni", label: "Juni", description: "German, feminine" },
+  { id: "flitz", label: "Flitz", description: "German, masculine" },
+  { id: "brise", label: "Brise", description: "French, feminine" },
+  { id: "sillage", label: "Sillage", description: "French, masculine" },
+  { id: "nira", label: "Nira", description: "Hindi, feminine" },
+  { id: "harema", label: "Harema", description: "Japanese, feminine" },
+  { id: "shida", label: "Shida", description: "Japanese, masculine" },
+  { id: "noeul", label: "Noeul", description: "Korean, feminine" },
+];
+
+const VOICE_OPTIONS: SelectFieldOption<string>[] = LIVE_VOICES.map((voice) => ({
+  id: voice.id,
+  value: voice.id,
+  label: voice.label,
+  description: voice.description,
+}));
+
+export function QuietCloseRow({
+  seconds,
+  onChange,
+}: {
+  seconds: number;
+  onChange: (seconds: number) => void;
+}) {
+  const { t } = useTranslation();
+  const options = useMemo(
+    () =>
+      QUIET_CLOSE_CHOICES.map((value) => ({
+        value,
+        label: t(`settings.voice.voiceMode.quietClose.options.${value}`),
+      })),
+    [t],
+  );
+  const handleChange = useCallback(
+    (value: QuietCloseChoice) => onChange(Number(value)),
+    [onChange],
+  );
+  return (
+    <SettingsRow
+      label={t("settings.voice.voiceMode.quietClose.label")}
+      hint={t("settings.voice.voiceMode.quietClose.hint")}
+    >
+      <SegmentedControl
+        options={options}
+        value={String(seconds) as QuietCloseChoice}
+        onValueChange={handleChange}
+        size="sm"
+        testID="voice-quiet-close"
+      />
+    </SettingsRow>
+  );
+}
+
+export function LiveVoiceRow({
+  voice,
+  onChange,
+}: {
+  voice: string;
+  onChange: (voice: string) => void;
+}) {
+  const { t } = useTranslation();
+  const display = useMemo(() => {
+    const selected = VOICE_OPTIONS.find((option) => option.value === voice);
+    return { label: selected?.label ?? voice, description: selected?.description };
+  }, [voice]);
+  const handleChange = useCallback((value: string) => onChange(value), [onChange]);
+  return (
+    <SettingsRow
+      label={t("settings.voice.voiceMode.liveVoice.label")}
+      hint={t("settings.voice.voiceMode.liveVoice.hint")}
+    >
+      <SelectField
+        label={t("settings.voice.voiceMode.liveVoice.label")}
+        value={voice}
+        selectedDisplay={display}
+        options={VOICE_OPTIONS}
+        onChange={handleChange}
+        placeholder={t("settings.voice.voiceMode.liveVoice.label")}
+        emptyText={t("settings.voice.voiceMode.liveVoice.label")}
+        searchable={false}
+        title={t("settings.voice.voiceMode.liveVoice.label")}
+        size="sm"
+        field={false}
+        triggerTestID="voice-live-voice"
+      />
+    </SettingsRow>
+  );
+}
+
+export function WhileAgentWorksRow({
+  mode,
+  onChange,
+}: {
+  mode: string;
+  onChange: (mode: string) => void;
+}) {
+  const { t } = useTranslation();
+  const options = useMemo(
+    () =>
+      WHILE_AGENT_WORKS_CHOICES.map((value) => ({
+        value,
+        label: t(`settings.voice.voiceMode.whileAgentWorks.options.${value}`),
+      })),
+    [t],
+  );
+  return (
+    <SettingsRow
+      label={t("settings.voice.voiceMode.whileAgentWorks.label")}
+      hint={t("settings.voice.voiceMode.whileAgentWorks.hint")}
+    >
+      <SegmentedControl
+        options={options}
+        value={mode as WhileAgentWorksChoice}
+        onValueChange={onChange}
+        size="sm"
+        testID="voice-while-agent-works"
+      />
+    </SettingsRow>
+  );
+}
