+        instructions: LIVE_INSTRUCTIONS,
+        audio: {
+          format: { type: "audio/pcm", rate: LIVE_RATE },
+          output: { voice },
+        },
+        input: sessionInput(agent, this.host, earlierVoice),
+        delegation: {
+          type: "responses",
+          responses: {
+            model: this.config.backendModel,
+            instructions: BACKEND_INSTRUCTIONS,
+            tools: BACKEND_TOOLS,
+            tool_choice: "auto",
+            parallel_tool_calls: false,
