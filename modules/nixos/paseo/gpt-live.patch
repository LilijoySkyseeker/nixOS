@@ -0,0 +1,38 @@
+import type { StreamItem } from "@/types/stream";
+
+// The daemon's voice bridge writes these (server session/voice/gpt-live-session.ts).
+
+const VOICE_PLUGIN_ID = "paseo-voice";
+const SPOKEN_TURN_KIND = "spoken_turn";
+const HANDOFF_ID_PREFIX = "voice-handoff:";
+// Earlier builds marked the hand-off text instead; threads from then still hold it.
+const LEGACY_HANDOFF_PREFIX = "(spoken) ";
+
+export interface SpokenTurn {
+  speaker: "user" | "voice";
+  text: string;
+}
+
+/** A spoken turn, which the thread shows as an ordinary message; null for anything else. */
+export function readSpokenTurn(item: StreamItem): SpokenTurn | null {
+  if (item.kind !== "plugin" || item.pluginId !== VOICE_PLUGIN_ID) return null;
+  if (item.itemKind !== SPOKEN_TURN_KIND) return null;
+  const data = item.data;
+  if (!data || typeof data !== "object" || Array.isArray(data)) return null;
+  const { speaker, text } = data;
+  if ((speaker !== "user" && speaker !== "voice") || typeof text !== "string") return null;
+  return { speaker, text };
+}
+
+/** The message the voice sent the agent for a spoken request; shown as "Sent to agent". */
+export function isVoiceHandoff(item: StreamItem): boolean {
+  if (item.kind !== "user_message") return false;
+  return (
+    [item.clientMessageId, item.messageId].some((id) => id?.startsWith(HANDOFF_ID_PREFIX)) ||
+    item.text.startsWith(LEGACY_HANDOFF_PREFIX)
+  );
+}
+
+export function handoffText(text: string): string {
+  return text.startsWith(LEGACY_HANDOFF_PREFIX) ? text.slice(LEGACY_HANDOFF_PREFIX.length) : text;
+}
