+describe("PacedPlayer", () => {
+  test("drops Live's silence between utterances so no backlog builds", () => {
+    let now = 0;
+    const out: { isLastChunk: boolean }[] = [];
+    vi.useFakeTimers();
+    const player = new PacedPlayer(
+      (chunk) => out.push(chunk),
+      () => now,
+    );
+
+    expect(player.push(Buffer.alloc(4800))).toBe(false);
+    expect(out).toHaveLength(0);
+    expect(player.isPlaying).toBe(false);
+
+    expect(player.push(tone(100))).toBe(true);
+    now = 100;
+    player.push(Buffer.alloc(4800)); // a short pause inside the utterance is kept
+    now = 600;
+    player.push(Buffer.alloc(4800)); // past the pause limit: dropped
+    player.tick();
+    expect(out.at(-1)!.isLastChunk).toBe(true);
+    expect(player.isPlaying).toBe(false);
+    // The dropped delta before speech is played first, so a quiet onset isn't clipped.
+    expect(out.filter((chunk) => !chunk.isLastChunk)).toHaveLength(3);
+  });
+
+  test("keeps at most the lead ahead of the listener", () => {
+    let now = 0;
+    const out: { chunkIndex: number; isLastChunk: boolean; audio: string }[] = [];
+    vi.useFakeTimers();
+    const player = new PacedPlayer(
+      (chunk) => out.push(chunk),
+      () => now,
+    );
+    player.push(tone(1000));
+
+    expect(out).toHaveLength(2); // 150 ms lead in 100 ms chunks
+    now = 100;
+    player.tick();
+    expect(out).toHaveLength(3);
+
+    player.reset();
+    now = 2000;
+    player.tick();
+    expect(out).toHaveLength(3);
+  });
+});
