+
+const AGENT_ID = "11111111-1111-4111-8111-111111111111";
+const PCM_16K = "audio/pcm;rate=16000;bits=16";
+
+/** Audible 24 kHz PCM16, as GPT-Live sends speech. */
+function tone(ms: number): Buffer {
+  const samples = (24000 * ms) / 1000;
+  const pcm = Buffer.alloc(samples * 2);
+  for (let i = 0; i < samples; i++) pcm.writeInt16LE(Math.round(8000 * Math.sin(i / 5)), i * 2);
+  return pcm;
+}
+
+class FakeHost implements GptLiveHost {
+  readonly emitted: SessionOutboundMessage[] = [];
+  readonly sent: string[] = [];
+  stopped = 0;
+  timeline: AgentTimelineItem[] = [];
+  disposition = "turn_started";
+  private readonly listeners = new Set<(event: AgentStreamEvent) => void>();
+
+  emit(msg: SessionOutboundMessage): void {
+    this.emitted.push(msg);
+  }
+
+  async loadAgent(agentId: string): Promise<ManagedAgent> {
+    return {
+      id: agentId,
+      provider: "claude",
+      cwd: "/work/site",
+      config: { title: "Website layout" },
+    } as unknown as ManagedAgent;
+  }
+
+  getTimeline(): AgentTimelineItem[] {
+    return this.timeline;
+  }
+
+  subscribeAgent(_agentId: string, listener: (event: AgentStreamEvent) => void): () => void {
+    this.listeners.add(listener);
+    return () => {
+      this.listeners.delete(listener);
+    };
+  }
+
+  async sendToAgent(_agentId: string, text: string): Promise<string> {
+    this.sent.push(text);
+    return this.disposition;
+  }
+
+  async stopAgent(): Promise<void> {
+    this.stopped += 1;
+  }
+
+  working = false;
+  readonly spokenTurns: string[] = [];
+
+  isAgentWorking(): boolean {
+    return this.working;
+  }
+
+  readonly liveCaptions: SpokenTurn[] = [];
+  async recordSpokenTurn(_agentId: string, turn: SpokenTurn): Promise<void> {
+    if (!turn.final) {
+      this.liveCaptions.push(turn);
+      return;
+    }
+    this.spokenTurns.push(`${turn.speaker}: ${turn.text}`);
+  }
+
+  agentEvent(event: AgentStreamEvent): void {
+    for (const listener of this.listeners) listener(event);
+  }
+
+  get subscribed(): boolean {
+    return this.listeners.size > 0;
+  }
+
+  ofType<T extends SessionOutboundMessage["type"]>(
+    type: T,
+  ): Extract<SessionOutboundMessage, { type: T }>[] {
+    return this.emitted.filter(
+      (msg): msg is Extract<SessionOutboundMessage, { type: T }> => msg.type === type,
+    );
+  }
+}
