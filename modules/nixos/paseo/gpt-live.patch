+   * GPT-Live sometimes answers a bare "stop" with "okay, I'll stop that" and never delegates, so the
+   * work runs on while the user thinks it stopped. A stop said while the voice was quiet and work
+   * is running stops the work here. Said over the voice, it only ends the speech.
+   */
+  private stopIfAskedTo(agentId: string, text: string): void {
+    const startedAt = this.userTurnStartedAt;
+    this.userTurnStartedAt = null;
+    if (!STOP_REQUEST.test(text.trim()) || !this.host.isAgentWorking(agentId)) return;
+    if (startedAt === null || startedAt - this.lastVoiceOutputAt < VOICE_QUIET_BEFORE_STOP_MS)
+      return;
+    this.logger.info({ agentId, text }, "GPT-Live stopping agent on a spoken stop");
+    void this.stopOnSpokenStop(agentId, text).catch((error) =>
+      this.logger.warn({ err: error }, "Stopping on a spoken stop failed"),
+    );
