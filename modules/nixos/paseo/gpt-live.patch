diff --git a/packages/server/src/server/session/voice/gpt-live-transcript.ts b/packages/server/src/server/session/voice/gpt-live-transcript.ts
new file mode 100644
index 000000000..605e19809
--- /dev/null
+++ b/packages/server/src/server/session/voice/gpt-live-transcript.ts
@@ -0,0 +1,285 @@
+import { randomUUID } from "node:crypto";
+import { appendFile, mkdir, readdir, readFile } from "node:fs/promises";
+import path from "node:path";
+import type pino from "pino";
+
+// One JSONL file per voice conversation, kept like agent chat transcripts. Spoken text
+// arrives as fragments; a turn is written when the other side speaks, after a pause,
+// or when something else happens in between, so each line reads as a message.
+
+const TURN_PAUSE_MS = 1500;
+// The voice pauses mid-sentence ("122.42 … degrees west"); its line ends at a pause only once the
+// sentence has. User transcripts often lack punctuation, so theirs end at any pause.
+const MID_SENTENCE_PAUSE_MS = 6000;
+
+export type TranscriptSpeaker = "user" | "voice";
+
+export interface TranscriptSessionInfo {
+  agentId: string;
+  provider: string;
+  cwd: string;
+  title: string | null;
+  liveSessionId: string | null;
+  model: string;
+  voice: string;
+  backendModel: string;
+}
+
+type TranscriptEntry =
+  | ({ type: "session_started" } & TranscriptSessionInfo)
+  | {
+      type: "turn";
+      speaker: TranscriptSpeaker;
+      text: string;
+      startMs?: number;
+      endMs?: number;
+      continues?: boolean;
+    }
+  | { type: "handoff"; tool: string; message?: string; result: string }
+  | { type: "agent_update"; content: string; spoken: boolean }
+  | { type: "session_closed"; reason: string; usageSeconds: number | null };
+
+interface OpenTurn {
+  id: string;
+  speaker: TranscriptSpeaker;
+  startedAt: Date;
+  text: string;
+  /** What the thread shows: the turn's text, after any earlier part it continues. */
+  shownBefore: string;
+  startMs?: number;
+  endMs?: number;
+  lastAt: number;
+}
+
+/** A voice turn cut by a hand-off, which the next voice words continue in the thread. */
+interface CarriedTurn {
+  id: string;
+  speaker: TranscriptSpeaker;
+  shown: string;
+  lastAt: number;
+}
+
+export interface SpokenTurn {
+  /** Stable across the updates of one turn. */
+  id: string;
+  speaker: TranscriptSpeaker;
+  text: string;
+  final: boolean;
+  /** When this part of the turn began (ms). */
+  startedAt: number;
+}
+
+export class VoiceTranscript {
+  private turn: OpenTurn | null = null;
+  private carried: CarriedTurn | null = null;
+  /** Called as a spoken turn grows (`final` false) and once when it ends (`final` true). */
+  onTurn: ((turn: SpokenTurn) => void) | null = null;
+  private pauseTimer: ReturnType<typeof setTimeout> | null = null;
+  private writes: Promise<void> = Promise.resolve();
+  private readonly file: string;
+
+  constructor(
+    dir: string,
+    info: TranscriptSessionInfo,
+    private readonly logger: pino.Logger,
+    private readonly now: () => Date = () => new Date(),
+  ) {
+    const stamp = this.now().toISOString().replace(/[:.]/g, "-");
+    this.file = path.join(dir, info.agentId, `${stamp}.jsonl`);
+    this.writes = mkdir(path.dirname(this.file), { recursive: true }).then(() => undefined);
+    this.write({ type: "session_started", ...info });
+  }
+
+  get path(): string {
+    return this.file;
+  }
+
+  fragment(speaker: TranscriptSpeaker, text: string, startMs?: number, endMs?: number): void {
+    const at = this.now().getTime();
+    const open = this.turn;
+    if (open && (open.speaker !== speaker || at - open.lastAt > pauseLimit(open))) this.flushTurn();
+    if (!this.turn) this.turn = this.openTurn(speaker, at, startMs);
+    const turn = this.turn;
+    // Live sometimes sends broken characters (U+FFFD), and a turn can open with stray symbols or
+    // the end of the previous one's punctuation ("? Never mind", "��>").
+    const clean = text.replace(/\uFFFD/g, "");
+    turn.text = turn.text
+      ? joinFragment(turn.text, clean)
+      : clean.replace(/^[^\p{L}\p{N}"'“‘(]+/u, "");
+    turn.endMs = endMs ?? turn.endMs;
+    turn.lastAt = at;
+    if (turn.text.trim()) this.emit(turn, false);
+    // Write the turn once the speaker pauses, so the file is readable during the conversation.
+    if (this.pauseTimer) clearTimeout(this.pauseTimer);
+    this.pauseTimer = setTimeout(() => this.flushTurn(), pauseLimit(turn));
+  }
+
+  handoff(tool: string, message: string | undefined, result: string): void {
+    this.breakTurn();
+    this.write({ type: "handoff", tool, ...(message ? { message } : {}), result });
+  }
+
+  agentUpdate(content: string, spoken: boolean): void {
+    this.breakTurn();
+    this.write({ type: "agent_update", content, spoken });
+  }
+
+  /** Writes what is pending; later calls are ignored by the caller dropping this object. */
+  close(reason: string, usageSeconds: number | null): Promise<void> {
+    this.flushTurn();
+    this.write({ type: "session_closed", reason, usageSeconds });
+    return this.writes;
+  }
+
+  private openTurn(speaker: TranscriptSpeaker, at: number, startMs?: number): OpenTurn {
+    const carried = this.carried;
+    this.carried = null;
+    const continues = carried?.speaker === speaker && at - carried.lastAt <= TURN_PAUSE_MS;
+    return {
+      id: continues ? carried!.id : randomUUID(),
+      speaker,
+      text: "",
+      shownBefore: continues ? carried!.shown : "",
+      startMs,
+      lastAt: at,
+      startedAt: this.now(),
+    };
+  }
+
+  /**
+   * Ends the open turn in the log, so it stays before the event that cut it. The voice often
+   * hands off mid-sentence ("Sure, I'll | check that."); when it carries straight on, the thread
+   * keeps one line.
+   */
+  private breakTurn(): void {
+    const turn = this.turn;
+    this.flushTurn();
+    // Either side can be mid-sentence when a hand-off goes out ("And the | longest river").
+    if (turn?.text.trim()) {
+      this.carried = {
+        id: turn.id,
+        speaker: turn.speaker,
+        shown: shownText(turn),
+        lastAt: this.now().getTime(),
+      };
+    }
+  }
+
+  private emit(turn: OpenTurn, final: boolean): void {
+    this.onTurn?.({
+      id: turn.id,
+      speaker: turn.speaker,
+      text: shownText(turn),
+      final,
+      startedAt: turn.startedAt.getTime(),
+    });
+  }
+
+  private flushTurn(): void {
+    if (this.pauseTimer) clearTimeout(this.pauseTimer);
+    this.pauseTimer = null;
+    const turn = this.turn;
+    this.turn = null;
+    // Punctuation alone (a stray "." after a reply) is no line.
+    if (!turn || !/[\p{L}\p{N}]/u.test(turn.text)) return;
+    this.write(
+      {
+        type: "turn",
+        speaker: turn.speaker,
+        text: turn.text.trim(),
+        ...(turn.startMs !== undefined ? { startMs: turn.startMs } : {}),
+        ...(turn.endMs !== undefined ? { endMs: turn.endMs } : {}),
+        // Carries on the voice's sentence from before a hand-off; the thread shows one line.
+        ...(turn.shownBefore ? { continues: true } : {}),
+      },
+      turn.startedAt,
+    );
+    this.emit(turn, true);
+  }
+
+  /** `at` is when the entry happened; a turn is written after it ends, so it passes its start. */
+  private write(entry: TranscriptEntry, at: Date = this.now()): void {
+    const line = `${JSON.stringify({ at: at.toISOString(), ...entry })}\n`;
+    this.writes = this.writes
+      .then(() => appendFile(this.file, line, { mode: 0o600 }))
+      .catch((error) =>
+        this.logger.warn({ err: error, file: this.file }, "Voice transcript write failed"),
+      );
+  }
+}
+
+function pauseLimit(turn: OpenTurn): number {
+  const midSentence = turn.speaker === "voice" && !/[.!?…]["')\]]*$/.test(turn.text.trim());
+  return midSentence ? MID_SENTENCE_PAUSE_MS : TURN_PAUSE_MS;
+}
+
+function shownText(turn: OpenTurn): string {
+  const text = turn.text.trim();
+  if (!turn.shownBefore) return text;
+  return /^[.,!?…]/.test(text) ? turn.shownBefore + text : `${turn.shownBefore} ${text}`;
+}
+
+/** Separate replies arrive back to back ("it." + "On it."); keep a space between sentences. */
+function joinFragment(text: string, fragment: string): string {
+  if (/[.!?…]$/.test(text) && /^[^\s.,!?…]/.test(fragment)) return `${text} ${fragment}`;
+  return text + fragment;
+}
+
+/**
+ * The end of this agent's earlier voice conversations, oldest first, for seeding a new voice
+ * session: a new GPT-Live session otherwise knows only the typed thread.
+ */
+export async function readEarlierVoiceConversation(
+  dir: string,
+  agentId: string,
+  maxChars: number,
+): Promise<string> {
+  const folder = path.join(dir, agentId);
+  const files = await readdir(folder).catch(() => [] as string[]);
+  const lines: string[] = [];
+  // File names start with the session's start time, so they sort chronologically.
+  for (const file of files
+    .filter((name) => name.endsWith(".jsonl"))
+    .sort()
+    .slice(-5)) {
+    const content = await readFile(path.join(folder, file), "utf8").catch(() => "");
+    for (const line of content.split("\n")) {
+      const entry = parseEntry(line);
+      if (entry?.type === "session_started") lines.push(`[voice session started ${entry.at}]`);
+      else if (entry?.type === "turn") {
+        lines.push(`${entry.speaker === "user" ? "User" : "You"}: ${entry.text}`);
+      } else if (entry?.type === "handoff" && entry.message) {
+        lines.push(`(passed to the agent: ${entry.message})`);
+      }
+    }
+  }
+  const text = lines.join("\n");
+  return text.length <= maxChars ? text : `[earlier lines omitted]\n${text.slice(-maxChars)}`;
+}
+
+export type TranscriptRecord = TranscriptEntry & { at: string };
+
+/** Every voice conversation kept for this agent, oldest first. */
+export async function readVoiceTranscripts(
+  dir: string,
+  agentId: string,
+): Promise<{ file: string; entries: TranscriptRecord[] }[]> {
+  const folder = path.join(dir, agentId);
+  const files = await readdir(folder).catch(() => [] as string[]);
+  const transcripts: { file: string; entries: TranscriptRecord[] }[] = [];
+  for (const file of files.filter((name) => name.endsWith(".jsonl")).sort()) {
+    const content = await readFile(path.join(folder, file), "utf8").catch(() => "");
+    const entries = content.split("\n").flatMap((line) => parseEntry(line) ?? []);
+    transcripts.push({ file, entries });
+  }
+  return transcripts;
+}
+
+function parseEntry(line: string): (TranscriptEntry & { at: string }) | null {
+  if (!line.trim()) return null;
+  try {
+    return JSON.parse(line) as TranscriptEntry & { at: string };
+  } catch {
+    return null;
+  }
+}
