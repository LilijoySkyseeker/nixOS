diff --git a/packages/server/src/server/test-utils/fake-gpt-live.ts b/packages/server/src/server/test-utils/fake-gpt-live.ts
new file mode 100644
index 000000000..01dce5a59
--- /dev/null
+++ b/packages/server/src/server/test-utils/fake-gpt-live.ts
@@ -0,0 +1,88 @@
+import { mkdtemp, writeFile } from "node:fs/promises";
+import type { AddressInfo } from "node:net";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { WebSocketServer, type WebSocket } from "ws";
+
+export interface LiveEvent {
+  type: string;
+  [key: string]: unknown;
+}
+
+/** A stand-in GPT-Live endpoint that records client events and lets tests send server events. */
+export class FakeLive {
+  readonly received: LiveEvent[] = [];
+  readonly authHeaders: (string | undefined)[] = [];
+  private socket: WebSocket | null = null;
+  private waiters: Array<() => void> = [];
+
+  private constructor(private readonly server: WebSocketServer) {
+    server.on("connection", (socket, request) => {
+      this.socket = socket;
+      this.authHeaders.push(request.headers.authorization);
+      socket.on("message", (data) => {
+        const event = JSON.parse(data.toString()) as LiveEvent;
+        this.received.push(event);
+        if (event.type === "session.start") {
+          this.send({ type: "session.started", session: { id: "sess_1" } });
+        } else if (event.type === "session.close") {
+          this.send({ type: "session.closed", usage: { seconds: 3 }, reason: "client" });
+        }
+        for (const wake of this.waiters.splice(0)) wake();
+      });
+    });
+  }
+
+  static async start(): Promise<FakeLive> {
+    const server = new WebSocketServer({ port: 0, host: "127.0.0.1" });
+    await new Promise<void>((resolve) => server.once("listening", () => resolve()));
+    return new FakeLive(server);
+  }
+
+  get url(): string {
+    return `ws://127.0.0.1:${(this.server.address() as AddressInfo).port}`;
+  }
+
+  send(event: LiveEvent): void {
+    this.socket?.send(JSON.stringify(event));
+  }
+
+  ofType(type: string): LiveEvent[] {
+    return this.received.filter((event) => event.type === type);
+  }
+
+  async waitFor(type: string, count = 1): Promise<LiveEvent[]> {
+    while (this.ofType(type).length < count) {
+      await new Promise<void>((resolve) => this.waiters.push(resolve));
+    }
+    return this.ofType(type);
+  }
+
+  async close(): Promise<void> {
+    for (const client of this.server.clients) client.terminate();
+    await new Promise<void>((resolve) => this.server.close(() => resolve()));
+  }
+}
+
+export async function writeKeyFile(key: string): Promise<string> {
+  const dir = await mkdtemp(path.join(tmpdir(), "gpt-live-test-"));
+  const file = path.join(dir, "key");
+  await writeFile(file, `${key}\n`);
+  return file;
+}
+
+/** A Responses-backend function call as GPT-Live forwards it. */
+export function functionCall(
+  name: string,
+  args: Record<string, unknown>,
+  callId = "call_1",
+): LiveEvent {
+  return {
+    type: "response.event",
+    delegation_id: "item_1",
+    event: {
+      type: "response.output_item.done",
+      item: { type: "function_call", call_id: callId, name, arguments: JSON.stringify(args) },
+    },
+  };
+}
