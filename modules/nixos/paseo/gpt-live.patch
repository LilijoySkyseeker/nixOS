diff --git a/packages/server/src/server/session/voice/gpt-live-history.ts b/packages/server/src/server/session/voice/gpt-live-history.ts
new file mode 100644
index 000000000..fa7e5f8d0
--- /dev/null
+++ b/packages/server/src/server/session/voice/gpt-live-history.ts
@@ -0,0 +1,131 @@
+import type { HistoryTimelineEvent } from "../../agent/agent-manager.js";
+import type { AgentTimelineItem } from "../../agent/agent-sdk-types.js";
+import { HANDOFF_ID_PREFIX, isBackchannel, spokenTurnItem } from "./gpt-live-session.js";
+import { readVoiceTranscripts, type TranscriptRecord } from "./gpt-live-transcript.js";
+
+// A provider's own history holds the typed thread and the hand-offs (as plain user messages), but
+// not what was said by voice. The voice transcripts hold that, so a replayed thread gets its spoken
+// lines back in time order, and its hand-offs their "Sent to agent" mark.
+
+// How soon after a hand-off the voice's next words count as the same sentence (the bridge's turn
+// pause, gpt-live-transcript.ts TURN_PAUSE_MS).
+const CARRY_MS = 1500;
+
+interface RestoredTurn {
+  at: string;
+  item: AgentTimelineItem;
+}
+
+export async function restoreVoiceHistory(
+  transcriptDir: string,
+  agentId: string,
+  events: HistoryTimelineEvent[],
+): Promise<HistoryTimelineEvent[]> {
+  const transcripts = await readVoiceTranscripts(transcriptDir, agentId);
+  if (transcripts.length === 0 || events.length === 0) return events;
+  // Without provider times there is no telling where the spoken lines went.
+  if (!events.some((event) => event.timestamp)) return events;
+
+  const turns: RestoredTurn[] = [];
+  const handoffs: string[] = [];
+  for (const { file, entries } of transcripts) {
+    turns.push(...spokenTurns(file, entries));
+    for (const entry of entries) {
+      if (entry.type === "handoff" && entry.message && isDelivered(entry.result)) {
+        handoffs.push(entry.message.trim());
+      }
+    }
+  }
+
+  const marked = markHandoffs(events, handoffs);
+  return mergeByTime(marked, turns);
+}
+
+/** The thread's lines, as the bridge showed them: a voice line cut by a hand-off stays one line. */
+function spokenTurns(file: string, entries: TranscriptRecord[]): RestoredTurn[] {
+  const marksContinuations = entries.some((entry) => entry.type === "turn" && entry.continues);
+  const lines: { id: string; at: string; speaker: "user" | "voice"; text: string }[] = [];
+  let handoffAt: number | null = null;
+  entries.forEach((entry, index) => {
+    if (entry.type === "handoff") handoffAt = Date.parse(entry.at);
+    if (entry.type !== "turn") return;
+    const previous = lines.at(-1);
+    // Logs from before `continues` existed: the voice carrying straight on after a hand-off.
+    const continues = marksContinuations
+      ? entry.continues === true
+      : entry.speaker === "voice" &&
+        handoffAt !== null &&
+        Date.parse(entry.at) - handoffAt <= CARRY_MS;
+    if (continues && previous?.speaker === entry.speaker) {
+      previous.text = `${previous.text} ${entry.text}`;
+    } else {
+      // Stable across replays, so a re-read thread updates these lines instead of adding copies.
+      lines.push({
+        id: `${file}:${index}`,
+        at: entry.at,
+        speaker: entry.speaker,
+        text: entry.text,
+      });
+    }
+    handoffAt = null;
+  });
+  return lines
+    .filter((line) => !(line.speaker === "voice" && isBackchannel(line.text)))
+    .map(({ id, at, speaker, text }) => ({
+      at,
+      item: spokenTurnItem({ id, speaker, text }),
+    }));
+}
+
+function isDelivered(result: string): boolean {
+  try {
+    const { status } = JSON.parse(result) as { status?: unknown };
+    return status === "agent_started" || status === "added_to_current_work";
+  } catch {
+    return false;
+  }
+}
+
+/** Provider history drops the hand-off's id; find each hand-off by its text instead. */
+function markHandoffs(events: HistoryTimelineEvent[], handoffs: string[]): HistoryTimelineEvent[] {
+  const pending = [...handoffs];
+  let count = 0;
+  return events.map((event) => {
+    const item = event.item;
+    if (item.type !== "user_message" || item.clientMessageId?.startsWith(HANDOFF_ID_PREFIX)) {
+      return event;
+    }
+    const index = pending.findIndex((message) => item.text.trim().startsWith(message));
+    if (index < 0) return event;
+    pending.splice(index, 1);
+    count += 1;
+    return {
+      ...event,
+      item: { ...item, clientMessageId: `${HANDOFF_ID_PREFIX}restored-${count}` },
+    };
+  });
+}
+
+/** Each spoken line goes before the first replayed event that happened after it started. */
+function mergeByTime(
+  events: HistoryTimelineEvent[],
+  turns: RestoredTurn[],
+): HistoryTimelineEvent[] {
+  const pending = [...turns].sort((a, b) => a.at.localeCompare(b.at));
+  const merged: HistoryTimelineEvent[] = [];
+  let lastAt = "";
+  for (const event of events) {
+    // Events without a time happened with the one before them.
+    lastAt = event.timestamp ?? lastAt;
+    const due = lastAt ? pending.findIndex((turn) => turn.at >= lastAt) : 0;
+    const earlier = pending.splice(0, due < 0 ? pending.length : due);
+    merged.push(...earlier.map((turn) => asEvent(turn, event)), event);
+  }
+  const last = events.at(-1)!;
+  merged.push(...pending.map((turn) => asEvent(turn, last)));
+  return merged;
+}
+
+function asEvent(turn: RestoredTurn, neighbour: HistoryTimelineEvent): HistoryTimelineEvent {
+  return { type: "timeline", provider: neighbour.provider, item: turn.item, timestamp: turn.at };
+}
