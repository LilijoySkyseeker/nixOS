+async function startVoice(
+  host = new FakeHost(),
+  options: {
+    idleCloseMs?: number;
+    progressFlushMs?: number;
+    whileAgentWorks?: "keep_open" | "reopen" | "close";
+    enabled?: () => boolean;
+  } = {},
+) {
+  const transcriptDir = await mkdtemp(path.join(tmpdir(), "gpt-live-transcripts-"));
+  const live = await FakeLive.start();
+  liveServer = live;
+  const voice = new GptLiveVoiceSession({
+    host,
+    logger: pino({ level: "silent" }),
+    progressFlushMs: options.progressFlushMs,
+    config: {
+      enabled: () => options.enabled?.() ?? true,
+      apiKeyFile: await writeKeyFile("test-key"),
+      url: live.url,
+      model: "gpt-live-1",
+      voice: () => "marin",
+      backendModel: "gpt-6-luna",
+      backendServiceTier: "priority",
+      backendReasoningEffort: "low",
+      idleCloseMs: () => options.idleCloseMs ?? 60_000,
+      whileAgentWorks: () => options.whileAgentWorks ?? "keep_open",
+      transcriptDir,
+    },
+  });
+  await voice.handleSetVoiceMode(true, AGENT_ID, "req-1");
+  return { voice, host, live, transcriptDir };
+}
+
+interface StartedSession {
+  audio: { format: unknown };
+  input: Array<{ role: string; content: Array<{ text: string }> }>;
+  delegation: {
+    type: string;
+    responses: { model: string; tools: Array<{ name: string }> };
+  };
+}
+
+/** 100 ms of loud 16 kHz mic audio. */
+function loudMic(): Buffer {
+  const pcm = Buffer.alloc(3200);
+  for (let i = 0; i < 1600; i++) pcm.writeInt16LE(Math.round(4000 * Math.sin(i / 3)), i * 2);
+  return pcm;
+}
+
+function hasLastChunk(host: FakeHost): boolean {
+  return host.ofType("audio_output").some((message) => message.payload.isLastChunk);
+}
+
+function speechStates(host: FakeHost): boolean[] {
+  return host.ofType("voice_input_state").map((message) => message.payload.isSpeaking);
+}
