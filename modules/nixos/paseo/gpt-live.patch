+    expect(estimateTokens("AD-3")).toBeGreaterThanOrEqual(3);
+    expect(estimateTokens("7200")).toBeGreaterThanOrEqual(2);
+    expect(estimateTokens("The quick brown fox jumps over the lazy dog.")).toBeGreaterThanOrEqual(
+      10,
+    );
+  });
+});
+
+test("questions as GPT-Live transcribes them: often no question mark, follow-ups elliptical", () => {
+  for (const line of [
+    "And the longest river",
+    "and the longest river",
+    "What's the exact lat long",
+    "Where is San Francisco",
+    "What about Peru",
+    "Is it done",
+  ]) {
