diff --git a/packages/server/scripts/gpt-live-routing-check.ts b/packages/server/scripts/gpt-live-routing-check.ts
new file mode 100644
index 000000000..a44a1339f
--- /dev/null
+++ b/packages/server/scripts/gpt-live-routing-check.ts
@@ -0,0 +1,351 @@
+/**
+ * Plays spoken phrases into a real GPT-Live session through the voice bridge, with a stand-in agent,
+ * and reports for each phrase whether the voice answered it or handed it off, what it sent and
+ * said, and whether it relayed the agent's answer. Costs real GPT-Live time (about $0.05/minute);
+ * the run stops at --max-minutes.
+ *
+ * Usage: tsx scripts/gpt-live-routing-check.ts <phrases.json> <audio-dir> [--max-minutes N]
+ *        [--seed text]  an earlier agent answer in the stand-in's thread
+ *        [--save-audio out.pcm]  the voice's audio as the daemon sends it (24 kHz PCM16)
+ *   audio-dir: <index>.pcm per phrase, 16 kHz mono 16-bit little-endian PCM
+ * Needs PASEO_GPT_LIVE_API_KEY_FILE.
+ */
+import { appendFile, mkdtemp, readFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import pino from "pino";
+import type { ManagedAgent } from "../src/server/agent/agent-manager.js";
+import type { AgentStreamEvent, AgentTimelineItem } from "../src/server/agent/agent-sdk-types.js";
+import {
+  GptLiveVoiceSession,
+  readGptLiveConfig,
+  type GptLiveHost,
+} from "../src/server/session/voice/gpt-live-session.js";
+import type { SpokenTurn } from "../src/server/session/voice/gpt-live-transcript.js";
+import type { SessionOutboundMessage } from "../src/server/messages.js";
+
+interface Phrase {
+  say: string;
+  /** agent: handed off; voice: answered itself; stop: stopped the work; any: no routing check. */
+  expect: "agent" | "voice" | "stop" | "any";
+  /** How long the stand-in agent works on a hand-off from this phrase; default 2. */
+  busySeconds?: number;
+  /** How the stand-in agent's turn ends; default "answer". */
+  agentEnds?: "answer" | "fail" | "permission";
+  /** The stand-in's answer; default an answer carrying a code word, to check relaying. */
+  answer?: string;
+  /** Plan updates while it works, which reach the voice as progress notes. */
+  progress?: boolean;
+  /** Speak this phrase this many seconds after the previous one ended, without waiting for quiet. */
+  speakAfterSeconds?: number;
+  /** Regexes (case-insensitive) a hand-off must / must not match, and the voice must (not) say. */
+  sentMatches?: string;
+  sentNotMatches?: string;
+  saidMatches?: string;
+  saidNotMatches?: string;
+  note?: string;
+}
+
+interface Outcome {
+  handoffs: string[];
+  stops: number;
+  voice: string[];
+  heard: string[];
+  /** Code words the stand-in put in its answers; a relayed answer says them. */
+  codeWords: string[];
+}
+
+const CHUNK_BYTES = 3200; // 100 ms of 16 kHz PCM16
+const SETTLE_MS = 7000;
+const MAX_WAIT_MS = 45_000;
+const LIVE_DOLLARS_PER_MINUTE = 0.05;
+const CODE_WORDS = ["zebra", "lantern", "marble", "violet", "copper", "falcon", "pepper", "harbor"];
+
+function emptyOutcome(): Outcome {
+  return { handoffs: [], stops: 0, voice: [], heard: [], codeWords: [] };
+}
+
+class StandInHost implements GptLiveHost {
+  outcome = emptyOutcome();
+  lastEventAt = Date.now();
+  phrase: Phrase = { say: "", expect: "any" };
+  private working = false;
+  private turnTimers: ReturnType<typeof setTimeout>[] = [];
+  private answers = 0;
+  private readonly listeners = new Set<(event: AgentStreamEvent) => void>();
+
+  saveAudioTo: string | null = null;
+  private writes: Promise<void> = Promise.resolve();
+
+  emit(message: SessionOutboundMessage): void {
+    if (message.type !== "audio_output" || !this.saveAudioTo) return;
+    const pcm = Buffer.from(message.payload.audio, "base64");
+    const file = this.saveAudioTo;
+    this.writes = this.writes.then(() => appendFile(file, pcm));
+  }
+
+  flushAudio(): Promise<void> {
+    return this.writes;
+  }
+
+  async loadAgent(agentId: string): Promise<ManagedAgent> {
+    return {
+      id: agentId,
+      provider: "claude",
+      cwd: tmpdir(),
+      config: {},
+    } as unknown as ManagedAgent;
+  }
+
+  seed: string | null = null;
+
+  getTimeline(): AgentTimelineItem[] {
+    return this.seed ? [{ type: "assistant_message", text: this.seed }] : [];
+  }
+
+  subscribeAgent(_agentId: string, listener: (event: AgentStreamEvent) => void): () => void {
+    this.listeners.add(listener);
+    return () => this.listeners.delete(listener);
+  }
+
+  async sendToAgent(_agentId: string, text: string): Promise<string> {
+    this.outcome.handoffs.push(text);
+    this.touch();
+    if (this.working) return "steered";
+    this.working = true;
+    this.publish({ type: "turn_started", provider: "claude" });
+    this.startTurn(text, this.phrase);
+    return "turn_started";
+  }
+
+  async stopAgent(): Promise<void> {
+    this.outcome.stops += 1;
+    this.touch();
+    if (!this.working) return;
+    this.endTurn();
+    this.publish({
+      type: "turn_canceled",
+      provider: "claude",
+      reason: "stopped",
+    } as AgentStreamEvent);
+  }
+
+  isAgentWorking(): boolean {
+    return this.working;
+  }
+
+  async recordSpokenTurn(_agentId: string, turn: SpokenTurn): Promise<void> {
+    if (turn.final && turn.speaker === "voice") this.outcome.voice.push(turn.text);
+    if (turn.final && turn.speaker === "user") this.outcome.heard.push(turn.text);
+    this.touch();
+  }
+
+  private startTurn(request: string, phrase: Phrase): void {
+    const busyMs = (phrase.busySeconds ?? 2) * 1000;
+    if (phrase.progress) {
+      for (let step = 1; step * 4000 < busyMs; step += 1) {
+        this.turnTimers.push(
+          setTimeout(() => {
+            const items = [1, 2, 3].map((n) => ({
+              text: `Step ${n}`,
+              completed: n <= step,
+              status: n === step + 1 ? ("in_progress" as const) : undefined,
+            }));
+            this.publish({ type: "timeline", provider: "claude", item: { type: "todo", items } });
+          }, step * 4000),
+        );
+      }
+    }
+    this.turnTimers.push(setTimeout(() => this.finish(request, phrase), busyMs));
+  }
+
+  private finish(request: string, phrase: Phrase): void {
+    this.endTurn();
+    switch (phrase.agentEnds ?? "answer") {
+      case "fail":
+        this.publish({ type: "turn_failed", provider: "claude", error: "The disk is full." });
+        return;
+      case "permission":
+        this.working = true;
+        this.publish({
+          type: "permission_requested",
+          provider: "claude",
+          request: {
+            id: "perm-1",
+            provider: "claude",
+            name: "Bash",
+            kind: "tool",
+            title: "Run rm -rf build/",
+          },
+        } as AgentStreamEvent);
+        return;
+      case "answer": {
+        let text = phrase.answer;
+        if (!text) {
+          const word = CODE_WORDS[this.answers++ % CODE_WORDS.length]!;
+          this.outcome.codeWords.push(word);
+          // A statement, not an instruction: answers are information to the voice, so it
+          // must not act on one, only report it.
+          text = `The answer is ${word}.`;
+        }
+        this.publish({
+          type: "timeline",
+          provider: "claude",
+          item: { type: "assistant_message", text },
+        });
+        this.publish({ type: "turn_completed", provider: "claude" });
+      }
+    }
+  }
+
+  private endTurn(): void {
+    this.working = false;
+    for (const timer of this.turnTimers) clearTimeout(timer);
+    this.turnTimers = [];
+  }
+
+  private publish(event: AgentStreamEvent): void {
+    this.touch();
+    for (const listener of this.listeners) listener(event);
+  }
+
+  private touch(): void {
+    this.lastEventAt = Date.now();
+  }
+}
+
+const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
+
+async function speak(voice: GptLiveVoiceSession, pcm: Buffer): Promise<void> {
+  // Real-time pace, then silence so the turn ends.
+  const padded = Buffer.concat([pcm, Buffer.alloc(CHUNK_BYTES * 15)]);
+  for (let offset = 0; offset < padded.length; offset += CHUNK_BYTES) {
+    const chunk = padded.subarray(offset, offset + CHUNK_BYTES);
+    voice.handleAudioChunk(chunk.toString("base64"), "audio/pcm;rate=16000;bits=16");
+    await sleep(100);
+  }
+}
+
+function routing({ stops, handoffs, voice }: Outcome): string {
+  if (stops > 0) return "stop";
+  if (handoffs.length > 0) return "agent";
+  return voice.length > 0 ? "voice" : "nothing";
+}
+
+function matches(pattern: string, text: string): boolean {
+  return new RegExp(pattern, "i").test(text);
+}
+
+function checks(phrase: Phrase, outcome: Outcome): string[] {
+  const problems: string[] = [];
+  const got = routing(outcome);
+  if (phrase.expect !== "any" && got !== phrase.expect) {
+    problems.push(`expected ${phrase.expect}, got ${got}`);
+  }
+  const sent = outcome.handoffs.map((text) => text.split("\n\n(")[0]!);
+  const said = outcome.voice.join(" ");
+  const { sentMatches, sentNotMatches, saidMatches, saidNotMatches } = phrase;
+  if (sentMatches && !sent.some((text) => matches(sentMatches, text))) {
+    problems.push(`no hand-off matched /${sentMatches}/`);
+  }
+  if (sentNotMatches && sent.some((text) => matches(sentNotMatches, text))) {
+    problems.push(`a hand-off matched /${sentNotMatches}/`);
+  }
+  if (saidMatches && !matches(saidMatches, said)) {
+    problems.push(`the voice never said /${saidMatches}/`);
+  }
+  if (saidNotMatches && matches(saidNotMatches, said)) {
+    problems.push(`the voice said /${saidNotMatches}/`);
+  }
+  for (const word of outcome.codeWords) {
+    if (!said.toLowerCase().includes(word)) problems.push(`answer not relayed (code word ${word})`);
+  }
+  return problems;
+}
+
+function report(index: number, phrase: Phrase, outcome: Outcome): boolean {
+  const problems = checks(phrase, outcome);
+  const status = problems.length === 0 ? "ok  " : "FAIL";
+  const head = `${status} ${index + 1}. "${phrase.say}" → ${routing(outcome)}`;
+  console.log(phrase.note ? `${head}  (${phrase.note})` : head);
+  for (const problem of problems) console.log(`       !! ${problem}`);
+  for (const line of outcome.heard) console.log(`       heard: ${line}`);
+  for (const message of outcome.handoffs)
+    console.log(`       sent: ${message.replace(/\n/g, " ⏎ ")}`);
+  for (const line of outcome.voice) console.log(`       said: ${line}`);
+  return problems.length === 0;
+}
+
+async function settle(host: StandInHost): Promise<void> {
+  const started = Date.now();
+  while (Date.now() - host.lastEventAt < SETTLE_MS && Date.now() - started < MAX_WAIT_MS) {
+    await sleep(250);
+  }
+}
+
+interface Pending {
+  index: number;
+  phrase: Phrase;
+  outcome: Outcome;
+}
+
+async function main(): Promise<void> {
+  const args = process.argv.slice(2);
+  const [phrasesFile, audioDir] = args;
+  const maxMinutesFlag = args.indexOf("--max-minutes");
+  const maxMinutes = maxMinutesFlag >= 0 ? Number(args[maxMinutesFlag + 1]) : 10;
+  if (!phrasesFile || !audioDir) throw new Error("usage: <phrases.json> <audio-dir>");
+  const phrases = JSON.parse(await readFile(phrasesFile, "utf8")) as Phrase[];
+  const transcriptDir = await mkdtemp(path.join(tmpdir(), "gpt-live-routing-"));
+  // No quiet close: it would end the session between phrases.
+  const env = {
+    ...process.env,
+    PASEO_GPT_LIVE_TRANSCRIPT_DIR: transcriptDir,
+    PASEO_GPT_LIVE_IDLE_SECONDS: "0",
+  };
+  const config = readGptLiveConfig(env, tmpdir());
+  if (!config) throw new Error("PASEO_GPT_LIVE_API_KEY_FILE is not set");
+  const host = new StandInHost();
+  const seedFlag = args.indexOf("--seed");
+  if (seedFlag >= 0) host.seed = args[seedFlag + 1] ?? null;
+  const saveAudioFlag = args.indexOf("--save-audio");
+  if (saveAudioFlag >= 0) host.saveAudioTo = args[saveAudioFlag + 1] ?? null;
+  const voice = new GptLiveVoiceSession({
+    host,
+    logger: pino({ level: process.env.LOG_LEVEL ?? "warn" }),
+    config,
+  });
+  const sessionStart = Date.now();
+  await voice.handleSetVoiceMode(true, "routing-check", "start");
+  await sleep(2000);
+
+  let passed = 0;
+  let pending: Pending | null = null;
+  for (const [index, phrase] of phrases.entries()) {
+    if ((Date.now() - sessionStart) / 60_000 > maxMinutes) {
+      console.log(`Stopped before phrase ${index + 1}: over ${maxMinutes} minutes.`);
+      break;
+    }
+    if (phrase.speakAfterSeconds === undefined) {
+      if (pending && report(pending.index, pending.phrase, pending.outcome)) passed += 1;
+      host.outcome = emptyOutcome();
+    } else {
+      // Spoken into whatever the previous phrase started; its outcome is reported with it.
+      await sleep(phrase.speakAfterSeconds * 1000);
+    }
+    host.phrase = phrase;
+    await speak(voice, await readFile(path.join(audioDir, `${index}.pcm`)));
+    pending = { index, phrase, outcome: host.outcome };
+    if (phrases[index + 1]?.speakAfterSeconds === undefined) await settle(host);
+  }
+  if (pending && report(pending.index, pending.phrase, pending.outcome)) passed += 1;
+  await voice.cleanup();
+  await host.flushAudio();
+  const minutes = (Date.now() - sessionStart) / 60_000;
+  const dollars = (minutes * LIVE_DOLLARS_PER_MINUTE).toFixed(2);
+  console.log(
+    `${passed} checks passed. Live session ${minutes.toFixed(1)} min ≈ $${dollars} (plus the hand-off model).`,
+  );
+}
+
+await main();
