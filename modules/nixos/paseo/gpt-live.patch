index 000000000..9217040af
--- /dev/null
+++ b/packages/app/src/audio/audio-engine.web.test.ts
@@ -0,0 +1,139 @@
+import { afterEach, expect, test, vi } from "vitest";
+
+vi.mock("@/desktop/host", () => ({ isElectronRuntime: () => true }));
+
+import { createAudioEngine } from "./audio-engine.web";
+
+/** A clock-driven stand-in for the Web Audio graph: records when each buffer was started. */
+class FakeAudioContext {
+  static last: FakeAudioContext | null = null;
+  currentTime = 0;
+  readonly sampleRate = 48000;
+  state = "running";
+  readonly destination = {};
+  readonly sources: FakeBufferSource[] = [];
+
+  constructor() {
+    FakeAudioContext.last = this;
+  }
+
+  createBuffer(_channels: number, length: number, sampleRate: number) {
+    return { duration: length / sampleRate, getChannelData: () => new Float32Array(length) };
+  }
+
+  createBufferSource(): FakeBufferSource {
+    const source = new FakeBufferSource();
+    this.sources.push(source);
+    return source;
+  }
+
+  /** Moves the clock and fires "ended" for buffers that finished. */
+  advance(seconds: number): void {
+    this.currentTime += seconds;
+    for (const source of this.sources) {
+      const duration = source.buffer?.duration ?? 0;
+      if (
+        source.startedAt !== null &&
+        !source.ended &&
+        source.startedAt + duration <= this.currentTime
+      ) {
+        source.ended = true;
+        source.onEnded?.();
+      }
+    }
+  }
+}
+
+class FakeBufferSource {
+  buffer: { duration: number } | null = null;
+  startedAt: number | null = null;
+  stopped = false;
+  ended = false;
+  onEnded: (() => void) | null = null;
+  connect(): void {}
+  disconnect(): void {}
+  addEventListener(_type: "ended", listener: () => void): void {
+    this.onEnded = listener;
+  }
+  start(when = 0): void {
+    this.startedAt = when;
+  }
+  stop(): void {
+    this.stopped = true;
+  }
+}
+
+function pcmChunk(ms: number) {
+  const bytes = new Uint8Array((16000 * 2 * ms) / 1000);
+  return {
+    size: bytes.byteLength,
+    type: "audio/pcm;rate=16000;bits=16",
+    async arrayBuffer() {
+      return bytes.buffer;
+    },
+  };
+}
+
+function createEngine() {
+  vi.stubGlobal("window", { AudioContext: FakeAudioContext });
+  return createAudioEngine({ onCaptureData: () => {}, onVolumeLevel: () => {} });
+}
+
+afterEach(() => {
+  vi.useRealTimers();
+  vi.unstubAllGlobals();
+});
+
+test("streamed PCM chunks are scheduled back to back", async () => {
+  vi.useFakeTimers();
+  const engine = createEngine();
+  const played = [
+    engine.play(pcmChunk(100)),
+    engine.play(pcmChunk(100)),
+    engine.play(pcmChunk(100)),
+  ];
+  await vi.advanceTimersByTimeAsync(0);
+  const context = FakeAudioContext.last!;
+
+  for (let step = 0; step < 3; step += 1) {
+    context.advance(0.03);
+    await vi.advanceTimersByTimeAsync(30);
+  }
+  for (let step = 0; step < 10; step += 1) await vi.advanceTimersByTimeAsync(100);
+  await Promise.all(played);
+
+  // A new stream starts after a short jitter buffer; each later chunk where the previous ends.
+  const [first, second, third] = context.sources;
+  expect(first!.startedAt).toBeCloseTo(0.2, 9);
+  expect(second!.startedAt).toBeCloseTo(first!.startedAt! + first!.buffer!.duration, 9);
+  expect(third!.startedAt).toBeCloseTo(second!.startedAt! + second!.buffer!.duration, 9);
+  expect(third!.startedAt! + third!.buffer!.duration).toBeCloseTo(0.5, 3);
+});
+
+test("streamed chunks are scheduled on arrival, ahead of what is playing", async () => {
+  vi.useFakeTimers();
+  const engine = createEngine();
+  const played = Promise.all([engine.play(pcmChunk(100)), engine.play(pcmChunk(100))]);
+  // Let the queue's timers run while the audio clock stays at 0.
+  for (let step = 0; step < 10; step += 1) await vi.advanceTimersByTimeAsync(50);
+  await played;
+  const context = FakeAudioContext.last!;
+
+  // Both are scheduled while the clock has not moved: a busy main thread can't starve playback.
+  expect(context.currentTime).toBe(0);
+  expect(context.sources.map((source) => source.startedAt !== null)).toEqual([true, true]);
+});
+
+test("stopping playback silences chunks already scheduled", async () => {
+  vi.useFakeTimers();
+  const engine = createEngine();
+  const played = Promise.all([engine.play(pcmChunk(100)), engine.play(pcmChunk(100))]);
+  // Let the queue's timers run while the audio clock stays at 0.
+  for (let step = 0; step < 10; step += 1) await vi.advanceTimersByTimeAsync(50);
+  await played;
+  const context = FakeAudioContext.last!;
+
+  engine.stop();
+
+  expect(context.sources.map((source) => source.stopped)).toEqual([true, true]);
+});
