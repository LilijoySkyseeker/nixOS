+import { afterEach, beforeEach, expect, test, vi } from "vitest";
+
+import type { AgentPromptInput } from "./agent/agent-sdk-types.js";
+import { getFullAccessConfig } from "./daemon-e2e/agent-configs.js";
+import { createTestAgentClients } from "./test-utils/fake-agent-client.js";
+import { createDaemonTestContext, type DaemonTestContext } from "./test-utils/index.js";
+import { FakeLive, functionCall, writeKeyFile } from "./test-utils/fake-gpt-live.js";
+
+// Voice through GPT-Live drives a real daemon session: handoffs steer the running agent,
+// talking never interrupts it, and only an explicit stop does.
+
+let live: FakeLive;
+let ctx: DaemonTestContext | null = null;
+const env = { ...process.env };
+
+beforeEach(async () => {
+  live = await FakeLive.start();
+  process.env.PASEO_GPT_LIVE_API_KEY_FILE = await writeKeyFile("test-key");
+  process.env.PASEO_GPT_LIVE_URL = live.url;
+  process.env.PASEO_VOICE_MODE_ENABLED = "1";
+});
+
+afterEach(async () => {
+  await ctx?.cleanup();
+  ctx = null;
+  await live.close();
+  process.env = { ...env };
+});
+
+function textOf(prompt: AgentPromptInput): string {
+  return typeof prompt === "string"
+    ? prompt
+    : prompt.map((part) => ("text" in part ? part.text : "")).join("");
+}
+
+test("a spoken request steers the running agent; only stop_agent interrupts it", async () => {
+  let releaseTurn!: () => void;
+  const turnHeld = new Promise<void>((resolve) => {
+    releaseTurn = resolve;
+  });
+  const steered: string[] = [];
+  let interrupts = 0;
+  let started = false;
+  ctx = await createDaemonTestContext({
+    agentClients: createTestAgentClients({
+      onStartTurn: () => {
+        started = true;
+      },
+      beforeTurnComplete: async (prompt) => {
+        if (textOf(prompt) === "Redesign the header") await turnHeld;
+      },
+      steerActiveTurn: async (prompt) => {
+        steered.push(textOf(prompt));
+        return { status: "accepted" };
+      },
+      onInterrupt: () => {
+        interrupts += 1;
+        releaseTurn();
+      },
+    }),
+  });
+  const agent = await ctx.client.createAgent({
+    config: { ...getFullAccessConfig("claude"), cwd: process.cwd() },
+    initialPrompt: "Redesign the header",
+    clientMessageId: "typed-1",
+  });
+  await vi.waitFor(() => expect(started).toBe(true));
+
+  await ctx.client.setVoiceMode(true, agent.id);
+  const [start] = await live.waitFor("session.start");
+  expect(JSON.stringify(start)).toContain("Redesign the header");
+
+  live.send({ type: "session.input_transcript.delta", delta: "Go ahead." });
+
+  live.send(functionCall("send_to_agent", { message: "Keep the logo on the left" }));
+  const [output] = await live.waitFor("response.item.create");
+  // The agent gets the request as plain text; nothing tells it to answer briefly for voice.
+  expect(steered).toEqual(["Keep the logo on the left"]);
+  expect(JSON.parse((output!.item as { output: string }).output).status).toBe(
+    "added_to_current_work",
+  );
+  expect(interrupts).toBe(0);
+
+  live.send(functionCall("stop_agent", {}, "call_2"));
+  await live.waitFor("response.item.create", 2);
+  expect(interrupts).toBe(1);
+
+  await ctx.client.setVoiceMode(false);
+  expect(live.ofType("session.close")).toHaveLength(1);
+});
+
+test("an agent's finished reply reaches the voice", async () => {
+  ctx = await createDaemonTestContext({ agentClients: createTestAgentClients() });
+  const agent = await ctx.client.createAgent({
+    config: { ...getFullAccessConfig("claude"), cwd: process.cwd() },
+  });
+  await ctx.client.setVoiceMode(true, agent.id);
+
+  live.send({ type: "session.input_transcript.delta", delta: "Go ahead." });
+
+  live.send(functionCall("send_to_agent", { message: "Say hello" }));
+  await live.waitFor("response.item.create");
+  await vi.waitFor(
+    () => expect(live.ofType("session.commentary.append").length).toBeGreaterThan(0),
+    { timeout: 10000 },
+  );
+  const [commentary] = live.ofType("session.commentary.append");
+  expect(commentary!.content).toMatch(/^The workspace's answer/);
+  const timeline = await ctx.client.fetchAgentTimeline(agent.id, { limit: 0 });
+  expect(timeline.entries.map((entry) => entry.item)).toContainEqual(
+    expect.objectContaining({
+      type: "user_message",
+      text: "Say hello",
+      clientMessageId: expect.stringMatching(/^voice-handoff:/),
+    }),
+  );
+
+  await ctx.client.setVoiceMode(false);
+});
+
+test("a quiet stretch ends voice and the app is told", async () => {
+  process.env.PASEO_GPT_LIVE_IDLE_SECONDS = "0.3";
+  ctx = await createDaemonTestContext({ agentClients: createTestAgentClients() });
+  const agent = await ctx.client.createAgent({
+    config: { ...getFullAccessConfig("claude"), cwd: process.cwd() },
+  });
+  const ended = new Promise<unknown>((resolve) => {
+    ctx!.client.on("set_voice_mode_response", (message) => {
+      if (message.type !== "set_voice_mode_response") return;
+      if (message.payload.requestId === "gpt-live-idle") resolve(message.payload);
+    });
+  });
+
+  await ctx.client.setVoiceMode(true, agent.id);
+
+  expect(await ended).toMatchObject({ enabled: false });
+  await live.waitFor("session.close");
+});
+
+test("a session started by voice keeps the spoken lines in its history", async () => {
+  ctx = await createDaemonTestContext({ agentClients: createTestAgentClients() });
+  // No typed first message: the session is started to talk.
+  const agent = await ctx.client.createAgent({
+    config: { ...getFullAccessConfig("claude"), cwd: process.cwd() },
+  });
+  await ctx.client.setVoiceMode(true, agent.id);
+  await live.waitFor("session.start");
+
+  live.send({ type: "session.input_transcript.delta", delta: "What's the capital of Sweden?" });
+  live.send({ type: "session.output_transcript.delta", delta: "Stockholm." });
+  await vi.waitFor(
+    async () => {
+      // The app reads history through this call; the spoken lines must pass its checks.
+      const timeline = await ctx!.client.fetchAgentTimeline(agent.id, { limit: 0 });
+      expect(timeline.entries.map((entry) => entry.item)).toEqual(
+        expect.arrayContaining([
+          expect.objectContaining({
+            type: "plugin",
+            pluginId: "paseo-voice",
+            data: { speaker: "user", text: "What's the capital of Sweden?" },
+          }),
+          expect.objectContaining({
+            type: "plugin",
+            pluginId: "paseo-voice",
+            data: { speaker: "voice", text: "Stockholm." },
+          }),
+        ]),
+      );
+    },
+    { timeout: 5000 },
+  );
+
+  await ctx.client.setVoiceMode(false);
+});
+
+test("a running turn that refuses a spoken message keeps working; the voice hears it's busy", async () => {
+  let releaseTurn!: () => void;
+  const turnHeld = new Promise<void>((resolve) => {
+    releaseTurn = resolve;
+  });
+  let started = false;
+  let interrupts = 0;
+  ctx = await createDaemonTestContext({
+    agentClients: createTestAgentClients({
+      onStartTurn: () => {
+        started = true;
+      },
+      beforeTurnComplete: async () => {
+        await turnHeld;
+      },
+      // Codex refuses a steer in some states (a slash command, a turn it can't match).
+      steerActiveTurn: async () => ({ status: "unavailable" }),
+      onInterrupt: () => {
+        interrupts += 1;
+      },
+    }),
+  });
+  const agent = await ctx.client.createAgent({
+    config: { ...getFullAccessConfig("claude"), cwd: process.cwd() },
+    initialPrompt: "Refactor the parser",
+  });
+  await vi.waitFor(() => expect(started).toBe(true));
+  await ctx.client.setVoiceMode(true, agent.id);
+  await live.waitFor("session.start");
+
+  live.send({ type: "session.input_transcript.delta", delta: "Go ahead." });
+
+  live.send(functionCall("send_to_agent", { message: "Also update the docs" }));
+  const [output] = await live.waitFor("response.item.create");
+
+  expect(JSON.parse((output!.item as { output: string }).output).status).toBe("not_delivered");
+  expect(interrupts).toBe(0);
+  releaseTurn();
+  await ctx.client.setVoiceMode(false);
+});
