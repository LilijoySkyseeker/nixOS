diff --git a/packages/app/src/audio/pcm/stream-resampler.test.ts b/packages/app/src/audio/pcm/stream-resampler.test.ts
new file mode 100644
index 000000000..515b0f6f0
--- /dev/null
+++ b/packages/app/src/audio/pcm/stream-resampler.test.ts
@@ -0,0 +1,31 @@
+import { expect, test } from "vitest";
+import { createStreamResampler } from "./index";
+
+function tone(length: number): Float32Array {
+  return Float32Array.from({ length }, (_, i) => Math.sin(i / 7));
+}
+
+test("a stream resampled in chunks matches the same audio resampled whole", () => {
+  const input = tone(16000);
+  const whole = createStreamResampler(16000, 48000)(input);
+
+  const chunked = createStreamResampler(16000, 48000);
+  const parts: number[] = [];
+  for (let offset = 0; offset < input.length; offset += 1600) {
+    parts.push(...chunked(input.subarray(offset, offset + 1600)));
+  }
+
+  expect(parts.length).toBe(whole.length);
+  const worst = Math.max(...parts.map((sample, i) => Math.abs(sample - whole[i]!)));
+  expect(worst).toBeLessThan(1e-6);
+});
+
+test("handles rates that don't divide evenly", () => {
+  const input = tone(16000);
+  const resample = createStreamResampler(16000, 44100);
+  let total = 0;
+  for (let offset = 0; offset < input.length; offset += 1000) {
+    total += resample(input.subarray(offset, offset + 1000)).length;
+  }
+  expect(Math.abs(total - 44100)).toBeLessThanOrEqual(3);
+});
