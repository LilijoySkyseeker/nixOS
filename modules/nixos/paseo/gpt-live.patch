index 000000000..0aa7e3bd4
--- /dev/null
+++ b/packages/server/src/server/session/voice/gpt-live-progress.ts
@@ -0,0 +1,57 @@
+import type { AgentTimelineItem } from "../../agent/agent-sdk-types.js";
+
+// Short notes about what the agent is doing, so the voice can answer "what's it doing?"
+// without a hand-off. Each note names the kind of one finished step; the bridge batches them. No
+// details: commands, paths and task text can carry what a file or page told the agent, and given
+// the agent's commentary, the voice tends to narrate it unprompted.
+
+export class ProgressNotes {
+  private readonly seenCalls = new Set<string>();
+
+  /** The note for one timeline item, or null when it adds nothing worth saying. */
+  describe(item: AgentTimelineItem): string | null {
+    return this.describeStep(item);
+  }
+
+  reset(): void {
+    this.seenCalls.clear();
+  }
+
+  private describeStep(item: AgentTimelineItem): string | null {
+    switch (item.type) {
+      case "tool_call": {
+        // A step is described once it finishes: providers often fill in the command or path
+        // only then, and a running call would read as "used Bash".
+        if (item.status === "running" || item.status === "canceled") return null;
+        if (this.seenCalls.has(item.callId)) return null;
+        this.seenCalls.add(item.callId);
+        return item.status === "failed" ? `${describeTool(item)} (failed)` : describeTool(item);
+      }
+      case "todo": {
+        const done = item.items.filter((task) => task.completed).length;
+        return `plan: ${done} of ${item.items.length} done`;
+      }
+      case "error":
+        return "hit an error";
+      default:
+        return null;
+    }
+  }
+}
+
+function describeTool(item: Extract<AgentTimelineItem, { type: "tool_call" }>): string {
+  switch (item.detail.type) {
+    case "shell":
+      return "ran a command";
+    case "read":
+      return "read a file";
+    case "edit":
+      return "edited a file";
+    case "write":
+      return "wrote a file";
+    case "search":
+      return "searched";
+    default:
+      return "used a tool";
+  }
+}
