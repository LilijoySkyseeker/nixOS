+  test("a long table answer reaches the voice under GPT-Live's 500-token limit", async () => {
+    const { voice, host, live } = await startVoice();
+    live.send({ type: "session.input_transcript.delta", delta: "Go ahead." });
+    live.send(functionCall("send_to_agent", { message: "Make the grid." }));
+    await live.waitFor("response.item.create");
+    host.agentEvent({
+      type: "timeline",
+      provider: "claude",
+      item: { type: "assistant_message", text: table },
+    });
+    host.agentEvent({ type: "turn_completed", provider: "claude" });
+    const [update] = await live.waitFor("session.commentary.append");
+    expect(estimateTokens(String(update!.content))).toBeLessThanOrEqual(400);
+    expect(String(update!.content)).toMatch(/ \[…\]$/);
