index 000000000..1af2d557d
--- /dev/null
+++ b/packages/server/src/server/daemon-e2e/voice-gpt-live-codex.real.e2e.test.ts
@@ -0,0 +1,119 @@
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import pino from "pino";
+import { afterEach, beforeEach, expect, test, vi } from "vitest";
+
+import { CodexAppServerAgentClient } from "../agent/providers/codex-app-server-agent.js";
+import { createDaemonTestContext, type DaemonTestContext } from "../test-utils/index.js";
+import { FakeLive, functionCall, writeKeyFile } from "../test-utils/fake-gpt-live.js";
+import { getFullAccessConfig } from "./agent-configs.js";
+
+// Voice with a real Codex agent behind it. GPT-Live is faked (its side was proven against the real
+// API); this checks what differs per provider: hand-offs, adding to a running turn, stopping, and
+// spoken lines coming back when the thread is re-read from Codex's own history.
+// Run with: PASEO_VOICE_REAL_CODEX=1 npx vitest run voice-gpt-live-codex.real.e2e.test.ts
+
+const enabled = process.env.PASEO_VOICE_REAL_CODEX === "1";
+let live: FakeLive;
+let ctx: DaemonTestContext | null = null;
+let cwd: string;
+const env = { ...process.env };
+
+beforeEach(async () => {
+  live = await FakeLive.start();
+  process.env.PASEO_GPT_LIVE_API_KEY_FILE = await writeKeyFile("test-key");
+  process.env.PASEO_GPT_LIVE_URL = live.url;
+  process.env.PASEO_VOICE_MODE_ENABLED = "1";
+  cwd = mkdtempSync(path.join(tmpdir(), "voice-codex-"));
+});
+
+afterEach(async () => {
+  await ctx?.cleanup();
+  ctx = null;
+  await live.close();
+  rmSync(cwd, { recursive: true, force: true });
+  process.env = { ...env };
+});
+
+function toolStatus(output: Record<string, unknown> | undefined): string {
+  return JSON.parse((output!.item as { output: string }).output).status as string;
+}
+
+test.skipIf(!enabled)(
+  "voice drives a real Codex agent: hand-off, mid-task message, stop, restored history",
+  async () => {
+    ctx = await createDaemonTestContext({
+      agentClients: { codex: new CodexAppServerAgentClient(pino({ level: "silent" })) },
+    });
+    const { client } = ctx;
+    // Started by voice: no typed first message.
+    const agent = await client.createAgent({ config: { ...getFullAccessConfig("codex"), cwd } });
+    await client.setVoiceMode(true, agent.id);
+    await live.waitFor("session.start");
+
+    // 1. A spoken exchange and a hand-off.
+    live.send({ type: "session.input_transcript.delta", delta: "Say the word alpha." });
+    live.send({ type: "session.output_transcript.delta", delta: "Sure, I'll check." });
+    live.send(functionCall("send_to_agent", { message: "Reply with exactly the word ALPHA." }));
+    const [first] = await live.waitFor("response.item.create");
+    expect(toolStatus(first)).toBe("agent_started");
+    await client.waitForFinish(agent.id, 120_000);
+    await vi.waitFor(
+      () =>
+        expect(
+          live.ofType("session.commentary.append").some((e) => String(e.content).includes("ALPHA")),
+        ).toBe(true),
+      { timeout: 10_000 },
+    );
+
+    // 2. A message while Codex works is added to the turn, never cancelling it.
+    live.send(
+      functionCall(
+        "send_to_agent",
+        { message: "Run the shell command `sleep 20`, then reply with exactly DONE." },
+        "call_2",
+      ),
+    );
+    await live.waitFor("response.item.create", 2);
+    // Give Codex time to be inside the shell command.
+    await new Promise((resolve) => setTimeout(resolve, 5_000));
+    live.send(
+      functionCall("send_to_agent", { message: "After that, also reply with BETA." }, "call_3"),
+    );
+    const third = (await live.waitFor("response.item.create", 3))[2];
+    expect(["added_to_current_work", "not_delivered"]).toContain(toolStatus(third));
+
+    // 3. An explicit stop stops it.
+    live.send(functionCall("stop_agent", {}, "call_4"));
+    const fourth = (await live.waitFor("response.item.create", 4))[3];
+    expect(toolStatus(fourth)).toBe("stopped");
+    await client.setVoiceMode(false);
+
+    // 4. Re-read from Codex's history: hand-offs keep their mark, spoken lines come back.
+    await client.refreshAgent(agent.id);
+    const timeline = await client.fetchAgentTimeline(agent.id, { limit: 0 });
+    const items = timeline.entries.map((entry) => entry.item);
+    const handoffs = items.filter(
+      (item) => item.type === "user_message" && item.clientMessageId?.startsWith("voice-handoff:"),
+    );
+    expect(handoffs.length).toBeGreaterThanOrEqual(2);
+    for (const item of handoffs) {
+      // The agent got plain text: nothing telling it the answer will be spoken.
+      expect(item.type === "user_message" && item.text).not.toMatch(/spoken|by voice/i);
+    }
+    const spoken = items.flatMap((item) =>
+      item.type === "plugin" && item.pluginId === "paseo-voice"
+        ? [(item.data as { text: string }).text]
+        : [],
+    );
+    expect(spoken).toEqual(expect.arrayContaining(["Say the word alpha.", "Sure, I'll check."]));
+    // The spoken request comes before its hand-off.
+    const askedAt = items.findIndex(
+      (item) =>
+        item.type === "plugin" && (item.data as { text: string }).text === "Say the word alpha.",
+    );
+    expect(askedAt).toBeLessThan(items.indexOf(handoffs[0]!));
+  },
+  300_000,
+);
