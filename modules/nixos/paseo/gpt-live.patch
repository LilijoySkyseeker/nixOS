+/**
+ * Linear resampler for a stream that arrives in chunks. Its position carries across calls,
+ * so the chunks resample as one signal: browsers resample each AudioBuffer on its own,
+ * which leaves a click at every chunk boundary.
+ */
+export function createStreamResampler(
+  inputRate: number,
+  outputRate: number,
+): (input: Float32Array) => Float32Array {
+  let produced = 0;
+  let consumed = 0;
+  let previous = 0;
+  return (input) => {
+    const out: number[] = [];
+    for (;;) {
+      // Exact from the running counts, so long streams don't drift.
+      const pos = (produced * inputRate) / outputRate - consumed;
+      if (pos > input.length - 1) break;
+      const i = Math.floor(pos);
+      const frac = pos - i;
+      const s0 = i < 0 ? previous : input[i];
+      const s1 = frac === 0 ? s0 : input[i + 1];
+      out.push(s0 + (s1 - s0) * frac);
+      produced += 1;
+    }
+    consumed += input.length;
+    if (input.length > 0) previous = input[input.length - 1];
+    return Float32Array.from(out);
+  };
+}
+
+export function pcm16LeToFloat32(bytes: Uint8Array): Float32Array {
+  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+  const out = new Float32Array(Math.floor(bytes.byteLength / 2));
+  for (let i = 0; i < out.length; i++) out[i] = view.getInt16(i * 2, true) / 0x8000;
+  return out;
+}
