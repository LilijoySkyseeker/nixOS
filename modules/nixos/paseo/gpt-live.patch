+
+  private async stopOnSpokenStop(agentId: string, text: string): Promise<void> {
+    await this.host.stopAgent(agentId);
+    this.transcript?.handoff("stop_agent", text, JSON.stringify({ status: "stopped" }));
+    this.appendContext(
