 #include <QTimer>
 
+// Command line of the process that asked polkit, read from the pid polkitd puts in the
+// details. The process wrote its own argv, so this informs the user; it proves nothing.
+static QString requesterCommandLine(const PolkitQt1::Details &details)
+{
+    bool ok = false;
+    const uint pid = details.lookup(QStringLiteral("polkit.subject-pid")).toUInt(&ok);
+    if (!ok || pid == 0) {
+        return {};
+    }
+
+    QFile file(QStringLiteral("/proc/%1/cmdline").arg(pid));
+    if (!file.open(QIODevice::ReadOnly)) {
+        return {};
+    }
+    constexpr qint64 maxLength = 4096;
+    QByteArray raw = file.read(maxLength + 1);
+    const bool truncated = raw.size() > maxLength;
+    raw.truncate(maxLength);
+    if (raw.endsWith('\0')) {
+        raw.chop(1);
+    }
+    if (raw.isEmpty()) {
+        return {};
+    }
+
+    QStringList args;
+    for (const QByteArray &rawArg : raw.split('\0')) {
+        QString arg = QString::fromLocal8Bit(rawArg);
+        // control, separator and bidi/format characters could fake line breaks or reorder the text
+        for (QChar &c : arg) {
+            const QChar::Category category = c.category();
+            if (category == QChar::Other_Control || category == QChar::Other_Format || category == QChar::Separator_Line
+                || category == QChar::Separator_Paragraph) {
+                c = QLatin1Char('?');
+            }
+        }
+        static const QRegularExpression unsafe(QStringLiteral("[^A-Za-z0-9_@%+=:,./-]"));
+        if (arg.isEmpty() || arg.contains(unsafe)) {
+            arg = QLatin1Char('\'') + arg.replace(QLatin1Char('\''), QLatin1String("'\\''")) + QLatin1Char('\'');
+        }
+        args << arg;
+    }
+    QString command = args.join(QLatin1Char(' '));
+    if (truncated) {
+        command += QStringLiteral(" …");
+    }
+    return command;
+}
