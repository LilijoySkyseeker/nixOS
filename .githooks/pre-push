#!/usr/bin/env bash
# Evaluate the flake and build (never switch) every NixOS host whose config
# changed in the commits being pushed, so breakage is caught before it
# reaches another machine. Bypass with `git push --no-verify`.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

zero="0000000000000000000000000000000000000000"
changed_files=""

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue # deleting a ref, nothing to build

  if [[ "$remote_sha" == "$zero" ]]; then
    # new branch: diff against its merge base with master, or the empty tree
    # if there is none. A failed merge-base must refuse, not collapse the
    # range to an empty working-tree diff that builds nothing.
    mb_rc=0
    base="$(git merge-base origin/master "$local_sha" 2>/dev/null)" || mb_rc=$?
    case "$mb_rc" in
      0) ;;
      1) base="$(git hash-object -t tree /dev/null)" ;;
      *)
        echo "BLOCKED: cannot compute a merge base for $local_sha (git exited $mb_rc); refusing to decide the build set from a failed range." >&2
        exit 1
        ;;
    esac
    range="$base..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  if ! files="$(git -c core.quotePath=false diff --name-only "$range" -- hosts/ modules/ files/ flake.nix flake.lock)"; then
    echo "BLOCKED: cannot diff $range; refusing to decide the build set from a failed diff." >&2
    exit 1
  fi
  changed_files+=$'\n'"$files"
done

changed_files="$(echo "$changed_files" | sed '/^$/d' | sort -u)"
[[ -z "$changed_files" ]] && exit 0

# anything outside hosts/ (modules/, files/, flake.*) affects every host
hosts="$(find hosts -mindepth 1 -maxdepth 1 -type d -printf '%f\n')"
global=0
if echo "$changed_files" | grep -qv '^hosts/'; then global=1; fi
to_build=""
for host in $hosts; do
  if [[ "$global" -eq 1 ]] || echo "$changed_files" | grep -q "^hosts/${host}/"; then
    to_build+=" $host"
  fi
done

echo "pre-push: nix flake check --no-build"
if ! nix flake check --no-build; then
  echo "BLOCKED: nix flake check failed. Fix it, or push with --no-verify." >&2
  exit 1
fi

[[ -z "$to_build" ]] && exit 0
echo "pre-push: building affected hosts:${to_build}"
for host in $to_build; do
  echo "--- nixos-rebuild build --flake .#${host} ---"
  if ! nixos-rebuild build --flake ".#${host}"; then
    echo "" >&2
    echo "BLOCKED: build failed for host '${host}'. Fix it, or push with --no-verify." >&2
    exit 1
  fi
done
exit 0
