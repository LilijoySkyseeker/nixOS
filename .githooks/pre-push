#!/usr/bin/env bash
# Build (don't switch) every NixOS host whose config changed in the commits
# being pushed, so breakage is caught before it lands on another machine.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

zero="0000000000000000000000000000000000000000"
changed_files=""

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue # deleting a ref, nothing to build

  if [[ "$remote_sha" == "$zero" ]]; then
    # New branch: diff against master, or against the empty tree if there is
    # no common ancestor. Checked, not swallowed: `|| true` collapsed the
    # range to a bare sha, which makes the diffs below *working-tree* diffs
    # -- empty on a clean checkout, exit 0 -- so neither the host build nor
    # the gate-mutants build ran, on exactly the new-branch push this arm
    # exists for. merge-base answers 1 for "no common ancestor" and 128 when
    # git itself fails.
    # plan: 2026-09-07-revise-the-plan-file-schema-state-first-four-frontmatter-fields.md#F73
    mb_rc=0
    base="$(git merge-base origin/master "$local_sha" 2>/dev/null)" || mb_rc=$?
    case "$mb_rc" in
      0) ;;
      1) base="$(git hash-object -t tree /dev/null)" ;;
      *)
        echo "BLOCKED: cannot compute a merge base for $local_sha (git exited $mb_rc); refusing to decide the build set from a failed range." >&2
        exit 1
        ;;
    esac
    range="$base..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  # core.quotePath=false so a non-ASCII hosts/ path is not C-quoted: the
  # quoted form fails the ^hosts/ selection below and would needlessly
  # build every host
  # plan: 2026-09-05-route-every-fact-into-one-channel-by-decidability-and-audience.md#F34
  # status checked, not swallowed: an unresolvable range read as "no host
  # config changed" and pushed unbuilt -- the fail-open this branch closed
  # at every other diff call site
  # plan: 2026-09-05-route-every-fact-into-one-channel-by-decidability-and-audience.md#F56
  if ! files="$(git -c core.quotePath=false diff --name-only "$range" -- hosts/ modules/ files/ flake.nix flake.lock)"; then
    echo "BLOCKED: cannot diff $range; refusing to decide the build set from a failed diff." >&2
    exit 1
  fi
  changed_files+=$'\n'"$files"

done

changed_files="$(echo "$changed_files" | sed '/^$/d' | sort -u)"

if [[ -z "$changed_files" ]]; then
  exit 0
fi

hosts="$(find hosts -mindepth 1 -maxdepth 1 -type d -printf '%f\n')"
to_build=""

# The diff's pathspec above is the only spelling of the trigger set: every
# listed path is a trigger, and any line outside hosts/ (modules/, files/,
# flake.*) affects all hosts. Same logic as verify-ladder's targeted
# build, deliberately -- the two build gates must not diverge
# plan: 2026-09-05-route-every-fact-into-one-channel-by-decidability-and-audience.md#F48
# plan: 2026-09-05-route-every-fact-into-one-channel-by-decidability-and-audience.md#F62
if echo "$changed_files" | grep -qv '^hosts/'; then
  global=1
else
  global=0
fi
for host in $hosts; do
  if [[ "$global" -eq 1 ]] || echo "$changed_files" | grep -q "^hosts/${host}/"; then
    to_build+=" $host"
  fi
done

if [[ -z "$to_build" ]]; then
  exit 0
fi

echo "pre-push: building affected hosts:${to_build}"

for host in $to_build; do
  echo "--- nixos-rebuild build --flake .#${host} ---"
  if ! nixos-rebuild build --flake ".#${host}"; then
    echo "" >&2
    echo "BLOCKED: build failed for host '${host}'. Fix it, or push with --no-verify to skip this check." >&2
    exit 1
  fi
done

exit 0
