#!/usr/bin/env bash
# Block obviously-plaintext secrets from being committed, and enforce that
# frozen docs/plans/{done,rejected}/ files never change (see
# docs/skills/plan/reference.md) -- both git-level, so they apply to any
# tool or human, not just a Claude Code session.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

# The binary probe below needs the blob on disk rather than in a variable,
# and needs git's own exit status rather than a pipeline's.
blob="$(mktemp)" || { echo "BLOCKED: cannot create a temporary file." >&2; exit 1; }
trap 'rm -f "$blob"' EXIT

# Frozen plans, by residence: docs/plans/{done,rejected}/ is append-never
# -- a file that lands there is never modified or deleted again, and git
# history is the integrity record. No checksum manifest: the one this
# check used to read produced the largest defect cluster in the system's
# own finding log while duplicating what git content-addressing already
# proves. plan-gate runs the same rule over the PR range in CI, so it
# holds for every tool and human at the merge boundary even when this
# hook is skipped. Additions pass (that is plan-move/plan-reject landing
# a file); --no-renames so a rename out of the folder shows as the
# deletion it is.
# plan: 2026-09-09-dismantle-the-blocking-gate-tier-and-keep-the-plan-corpus.md#D2
frozen_changed="$(git -c core.quotePath=false diff --cached --no-renames --name-only --diff-filter=MDT -- 'docs/plans/done/*.md' 'docs/plans/rejected/*.md')"
if [[ -n "$frozen_changed" ]]; then
  echo "BLOCKED: frozen plan(s) staged for modification or deletion -- new information becomes a new plan file that cites them, not an edit:" >&2
  echo "$frozen_changed" >&2
  echo "" >&2
  echo "If this is deliberate (e.g. undoing a mistaken plan-move before it ever merged), commit with 'git commit --no-verify'." >&2
  exit 1
fi

# Every docs/skills/<name>/ and docs/agents/<name>.md must have a correct
# symlink under .claude/ -- otherwise it silently vanishes from Claude Code
# with no visible error (confirmed real pitfall, not speculative).
if [[ -x "$repo_root/scripts/claude-links-check" ]]; then
  if ! "$repo_root/scripts/claude-links-check"; then
    echo "" >&2
    echo "Run 'scripts/claude-links-check --fix' to repair, or 'git commit --no-verify' if intentional." >&2
    exit 1
  fi
fi

# core.quotePath=false, and what it does not cover -- see
# plan_worktree_files in docs/skills/plan/scripts/lib.sh
# plan: 2026-09-05-route-every-fact-into-one-channel-by-decidability-and-audience.md#F42
# ACMRT excludes deletions and nothing else; ACM also dropped renames
# plan: 2026-09-05-route-every-fact-into-one-channel-by-decidability-and-audience.md#F45
staged_files="$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMRT)"
[[ -z "$staged_files" ]] && exit 0

fail=0

while IFS= read -r file; do
  # no working-tree test: every scan below reads the index, and ACMRT
  # already excludes deletions
  # plan: 2026-09-05-route-every-fact-into-one-channel-by-decidability-and-audience.md#F41

  # secrets.yaml files must be sops-encrypted (contain sops metadata block).
  if [[ "$(basename "$file")" == "secrets.yaml" ]]; then
    if ! git show ":$file" | grep -q '^sops:'; then
      echo "BLOCKED: $file looks unencrypted (no 'sops:' metadata block)." >&2
      fail=1
    fi
    continue
  fi

  # a gitlink is a commit id, not content: there is no blob to scan and
  # no secret it could carry, so skip it deliberately rather than fail
  # closed on it -- blocking would make `git submodule add` unfixable
  # except by --no-verify, which switches off every check in this hook
  # plan: 2026-09-05-route-every-fact-into-one-channel-by-decidability-and-audience.md#F57
  # Read the mode fail-closed, like the content read below and for the same
  # reason: an unreadable mode makes this exemption inconclusive, and an
  # inconclusive answer must not silently take the `continue` branch that
  # skips every scan for this file.
  # plan: 2026-09-07-revise-the-plan-file-schema-state-first-four-frontmatter-fields.md#F48
  if ! mode="$(git ls-files -s -- "$file")"; then
    echo "BLOCKED: cannot read the staged mode of $file; refusing to decide whether to scan it." >&2
    fail=1
    continue
  fi
  if [[ "$(cut -d' ' -f1 <<<"$mode")" == "160000" ]]; then
    continue
  fi

  # anything else that cannot be read is still fail-closed
  # plan: 2026-09-05-route-every-fact-into-one-channel-by-decidability-and-audience.md#F45
  if ! content="$(git show ":$file" 2>/dev/null)"; then
    echo "BLOCKED: cannot read the staged content of $file; refusing to scan it." >&2
    fail=1
    continue
  fi

  # binary detected from the blob's own bytes, never from
  # `git diff --numstat`, whose "-" answer comes from the `diff`
  # gitattribute: staging a .gitattributes saying `*.pem -diff` beside a
  # .pem holding a private key switched this scan off entirely, verified
  # plan: 2026-09-05-route-every-fact-into-one-channel-by-decidability-and-audience.md#F52
  # A second read, not `<<<"$content"`: command substitution strips NUL
  # bytes, so probing $content could never find one. Written to a file
  # rather than piped, so git's own status is checkable -- through a pipe
  # it is not, because `pipefail` reports the rightmost non-zero status and
  # grep's "no match" is also 1, making a failed read indistinguishable
  # from a text file.
  # plan: 2026-09-07-revise-the-plan-file-schema-state-first-four-frontmatter-fields.md#F48
  if ! git show ":$file" > "$blob"; then
    echo "BLOCKED: cannot re-read the staged content of $file to tell text from binary." >&2
    fail=1
    continue
  fi
  if grep -qaP '\x00' < "$blob"; then
    continue
  fi

  if grep -qE -- '-----BEGIN (RSA |EC |OPENSSH |DSA |)PRIVATE KEY-----' <<<"$content"; then
    echo "BLOCKED: $file contains a private key block." >&2
    fail=1
  fi

  if grep -qE 'AGE-SECRET-KEY-1[A-Z0-9]+' <<<"$content"; then
    echo "BLOCKED: $file contains an age secret key." >&2
    fail=1
  fi

  if grep -qE '(AKIA[0-9A-Z]{16}|xox[baprs]-[0-9A-Za-z-]{10,}|ghp_[0-9A-Za-z]{36})' <<<"$content"; then
    echo "BLOCKED: $file contains what looks like a live API/access token." >&2
    fail=1
  fi
done <<<"$staged_files"

if [[ "$fail" -eq 1 ]]; then
  echo "" >&2
  echo "If this is a false positive, commit with 'git commit --no-verify'." >&2
  exit 1
fi

exit 0
