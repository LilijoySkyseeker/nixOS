#!/usr/bin/env bash
# Block obviously-plaintext secrets, and lint staged .nix files. Git-level,
# so it applies to any tool or human. Bypass a false positive with
# `git commit --no-verify`.
set -euo pipefail

# the binary probe needs the blob on disk, and git's own exit status
blob="$(mktemp)" || { echo "BLOCKED: cannot create a temporary file." >&2; exit 1; }
trap 'rm -f "$blob"' EXIT

# core.quotePath=false: git otherwise C-quotes a non-ASCII path, which
# `git show :<path>` then cannot read. ACMRT: everything but deletions.
staged_files="$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMRT)"
[[ -z "$staged_files" ]] && exit 0

fail=0
staged_nix=()

while IFS= read -r file; do
  # secrets.yaml files must be sops-encrypted
  if [[ "$(basename "$file")" == "secrets.yaml" ]]; then
    if ! git show ":$file" | grep -q '^sops:'; then
      echo "BLOCKED: $file looks unencrypted (no 'sops:' metadata block)." >&2
      fail=1
    fi
    continue
  fi

  # unreadable means undecided, which must not skip the scan
  if ! mode="$(git ls-files -s -- "$file")"; then
    echo "BLOCKED: cannot read the staged mode of $file; refusing to decide whether to scan it." >&2
    fail=1
    continue
  fi
  # a gitlink (submodule) is a commit id, not content
  if [[ "$(cut -d' ' -f1 <<<"$mode")" == "160000" ]]; then
    continue
  fi

  if ! content="$(git show ":$file" 2>/dev/null)"; then
    echo "BLOCKED: cannot read the staged content of $file; refusing to scan it." >&2
    fail=1
    continue
  fi

  # binary from the blob's own bytes, never from the `diff` gitattribute,
  # which a staged `.gitattributes` could use to switch this scan off
  if ! git show ":$file" > "$blob"; then
    echo "BLOCKED: cannot re-read the staged content of $file to tell text from binary." >&2
    fail=1
    continue
  fi
  if grep -qaP '\x00' < "$blob"; then
    continue
  fi

  if grep -qE -- '-----BEGIN (RSA |EC |OPENSSH |DSA |)PRIVATE KEY-----' <<<"$content"; then
    echo "BLOCKED: $file contains a private key block." >&2
    fail=1
  fi
  if grep -qE 'AGE-SECRET-KEY-1[A-Z0-9]+' <<<"$content"; then
    echo "BLOCKED: $file contains an age secret key." >&2
    fail=1
  fi
  if grep -qE '(AKIA[0-9A-Z]{16}|xox[baprs]-[0-9A-Za-z-]{10,}|ghp_[0-9A-Za-z]{36})' <<<"$content"; then
    echo "BLOCKED: $file contains what looks like a live API/access token." >&2
    fail=1
  fi

  if [[ "$file" == *.nix ]]; then staged_nix+=("$file"); fi
done <<<"$staged_files"

if [[ "${#staged_nix[@]}" -gt 0 ]]; then
  for tool in nixfmt statix deadnix; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      echo "BLOCKED: $tool not on PATH. Commit from the dev shell (direnv, or 'direnv exec . git commit ...')." >&2
      exit 1
    fi
  done
  if ! nixfmt --check "${staged_nix[@]}"; then
    echo "BLOCKED: run 'nixfmt' on the file(s) above." >&2
    fail=1
  fi
  for f in "${staged_nix[@]}"; do
    if ! statix check "$f"; then
      echo "BLOCKED: statix finding in $f ('statix fix $f' handles most)." >&2
      fail=1
    fi
  done
  if ! deadnix --fail "${staged_nix[@]}"; then
    echo "BLOCKED: unused code above ('deadnix --edit <file>' removes it)." >&2
    fail=1
  fi
fi

if [[ "$fail" -eq 1 ]]; then
  echo "" >&2
  echo "If this is a false positive, commit with 'git commit --no-verify'." >&2
  exit 1
fi
exit 0
