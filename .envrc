# no dev shell: the hook tools come from the PCs' system packages
# (modules/nixos/desktop-apps.nix). This only turns the hooks on per clone.
if [ "$(git config --local --get core.hooksPath)" != ".githooks" ]; then
  git config --local core.hooksPath .githooks
fi
if [ "$(git config --local --get pull.rebase)" != "true" ]; then
  git config --local pull.rebase true
fi
