// Tailnet ACL / policy file, managed in the Tailscale admin console
// (https://login.tailscale.com/admin/acls/file) — not applied by Nix.
// Kept here only as a reference copy; update this file whenever the
// console policy changes so the two don't drift.
//
// Notes:
// - All hosts in this repo join as tagged devices (see
//   profiles/default.nix: authKeyFile + --advertise-tags=tag:<hostname>),
//   not as a logged-in user. autogroup:member only covers user identities,
//   so tagged devices need their own tags listed explicitly in any
//   grants/acls src that should include device-to-device access.
// - Exit node routing requires dst: autogroup:internet — granting access
//   to the tag itself only allows reaching the device (e.g. SSH), not
//   routing internet traffic through it.
// - autoApprovers references tag:homelab (not a user) so re-advertising
//   the exit node / subnet route auto-approves without manual admin
//   approval, and doesn't break if a user account is later suspended.
// - There is deliberately NO tag:isoimage. Removed 2026-08-27 by the
//   security audit (F-P8-19). It described a device that cannot exist:
//   hosts/isoimage's module list omits profile-default, so
//   services.tailscale.enable = false and config.sops is not even an
//   option there. An ISO is a bootable artifact that can be copied
//   anywhere and must not carry a tailnet identity — that is the design,
//   not an oversight. The matching tailscale_authkey_isoimage secret and
//   the never-used auth key behind it were retired at the same time.
//   Do not re-add the tag; if isoimage is ever genuinely meant to join,
//   that is a config change first (profile-default + sops-nix) and a new
//   non-reusable, pre-authorized, tagged key second.
{
    "tagOwners": {
        "tag:thinkpad": ["autogroup:admin"],
        "tag:torrent":  ["autogroup:admin"],
        "tag:homelab":  ["autogroup:admin"],
        "tag:vps":      ["autogroup:admin"],
    },

    "autoApprovers": {
        "exitNode": ["tag:homelab"],
        "routes": {
            "192.168.1.0/24": ["tag:homelab"],
        },
    },

    "grants": [
        // members and all tagged devices can reach each other
        {
            "src": ["autogroup:member", "tag:thinkpad", "tag:torrent", "tag:homelab"],
            "dst": ["tag:thinkpad", "tag:torrent", "tag:homelab"],
            "ip":  ["*"],
        },
        // vps is reachable for admin SSH by you and by all your other
        // tailnet devices (all tagged devices here belong to you) — it
        // doesn't need outbound access to anything beyond what the
        // internet grant below already covers
        {
            "src": ["autogroup:member", "tag:thinkpad", "tag:torrent", "tag:homelab"],
            "dst": ["tag:vps"],
            "ip":  ["*"],
        },
        // let members and tagged devices use homelab as an exit node
        {
            "src": ["autogroup:member", "tag:thinkpad", "tag:torrent", "tag:homelab"],
            "dst": ["autogroup:internet"],
            "ip":  ["*"],
        },
        // let members and tagged devices reach homelab's advertised LAN subnet
        {
            "src": ["autogroup:member", "tag:thinkpad", "tag:torrent", "tag:homelab"],
            "dst": ["192.168.1.0/24"],
            "ip":  ["*"],
        },
    ],

    // There is deliberately NO "ssh" block here any more.
    //
    // Removed 2026-08-26 by the security audit (F-P0-05 / F-P8-12). It had
    // no effect, because Tailscale SSH is not enabled on any host — verified
    // three independent ways: no --ssh in any host's evaluated
    // extraUpFlags, no `tailscale set --ssh` anywhere in the repo, and
    // `tailscale status --json` reporting sshHostKeys: null for every peer
    // (which also rules out an imperative enable the config would not show).
    //
    // It was removed rather than left inert because it was a loaded footgun:
    // a rule granting device-to-device SSH as **root** across tag:thinkpad,
    // tag:torrent, tag:homelab and tag:isoimage, disarmed only by a setting
    // in a different file. Two of those four hosts set PermitRootLogin =
    // "forced-commands-only" as their entire root-login policy, and
    // Tailscale SSH intercepts *all* SSH to a matched host, bypassing real
    // sshd including authorized_keys ForceCommand restrictions — it already
    // broke vps's push-deploy allowlist once, confirmed live. So anyone who
    // ever enabled --ssh would have silently granted exactly what those
    // hosts are configured to refuse.
    //
    // If Tailscale SSH is ever genuinely wanted, write the rules then, with
    // that trade-off in front of you. Do not restore these.
    //
    // The prohibition itself is documented at length in
    // modules/profiles/default.nix, which is the thing actually keeping
    // --ssh off.
}
