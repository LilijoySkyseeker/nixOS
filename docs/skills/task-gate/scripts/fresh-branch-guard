#!/usr/bin/env bash
# PreToolUse hook (matcher: Bash). Blocks creating a new branch
# (`git checkout -b`/`git switch -c`/`git branch <name>`) when local
# master is behind origin/master -- pulling first is already documented
# in docs/procedures/workflow.md's "Checks before you start", hardcoded
# here per the "hardcode with scripts, not agent judgment" tenet after a
# real incident: an entire session's worth of work was branched off stale
# local master, causing a large, avoidable rebase against 57 commits of
# drift once it was time to land.
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=hook-lib.sh
. "$SCRIPT_DIR/hook-lib.sh"

input="$(cat)"
tool_name="$(hook_json_str "$input" tool_name)"
[ "$tool_name" = "Bash" ] || exit 0

command="$(hook_json_command "$input")"
[ -n "$command" ] || exit 0

# Only new-branch-creating forms -- not a plain checkout/switch to an
# existing branch, not `git branch` (list) or `git branch -d` (delete).
is_new_branch=false
hook_anchored "$command" 'git([[:space:]]+-C[[:space:]]+\S+)?[[:space:]]+checkout[[:space:]]+[^;&|]*-b([[:space:]]|$)' && is_new_branch=true
hook_anchored "$command" 'git([[:space:]]+-C[[:space:]]+\S+)?[[:space:]]+switch[[:space:]]+[^;&|]*-c([[:space:]]|$)' && is_new_branch=true
hook_anchored "$command" 'git([[:space:]]+-C[[:space:]]+\S+)?[[:space:]]+branch[[:space:]]+[a-zA-Z0-9]' && is_new_branch=true
[ "$is_new_branch" = true ] || exit 0

cwd="$(hook_json_str "$input" cwd)"
root="$(cd "${cwd:-.}" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)"
[ -n "$root" ] || exit 0

remote_default="$(git -C "$root" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's#^refs/remotes/origin/##')"
default_branch="${remote_default:-master}"

git -C "$root" fetch origin "$default_branch" -q 2>/dev/null

local_ref="refs/heads/$default_branch"
remote_ref="refs/remotes/origin/$default_branch"
git -C "$root" show-ref --verify --quiet "$local_ref" || exit 0
git -C "$root" show-ref --verify --quiet "$remote_ref" || exit 0

behind="$(git -C "$root" rev-list --count "$local_ref".."$remote_ref" 2>/dev/null || echo 0)"
[ "$behind" -eq 0 ] 2>/dev/null && exit 0

hook_deny "PreToolUse" "BLOCKED: local $default_branch is $behind commit(s) behind origin/$default_branch. Pull first (git checkout $default_branch && git pull origin $default_branch), then branch from that -- branching from stale master risks a large, avoidable rebase later. If you're deliberately branching from a ref other than $default_branch and this is a false positive, use 'git commit --no-verify'-style judgment: switch to that ref first so this check no longer applies, or ask the user how they want to proceed."
