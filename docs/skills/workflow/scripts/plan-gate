#!/usr/bin/env bash
# plan-gate <base-ref> [<head-ref>]
# The merge boundary's one hard reviewer check, advisory about everything
# else. Refuses (non-zero exit) only if a commit in <base-ref>..<head-ref>
# cites a plan (via a "Plan: <file>.md" trailer) that still carries an
# unresolved CRITICAL- or HIGH-severity security finding. Every other
# review signal -- ordinary unresolved findings, a plan still open at
# merge time -- is printed as a NOTE and never blocks: reviews are
# advisory, and a finding may be parked with a note while the human
# merges when satisfied. Completion stamps are no longer read here at
# all; they stay in plan files as information about what ran, not as
# locks. Decided in
# 2026-09-09-dismantle-the-blocking-gate-tier-and-keep-the-plan-corpus.md#D1
# after the stamp-staleness block livelocked against its own review loop.
#
# The only automated caller is .github/workflows/plan-gate.yml, over the
# PR range; any other range (pre-deploy, say) has to be passed by hand.
# Read-only; never edits anything. A commit with no Plan: trailer (e.g.
# mark-trivial'd, or one authoring plans rather than executing one) is
# simply not gated here.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# Sourced relative to this script's own location, not $root -- CI pins a
# copy of this script (and this sibling lib.sh) fetched from the base
# branch before running it, specifically so a PR can't neuter its own
# gate by editing plan-gate/lib.sh in the same commit range it's supposed
# to be gated by (see .github/workflows/plan-gate.yml). Sourcing via
# $root here would silently defeat that pinning by pulling the PR's own
# (possibly tampered) copy back in regardless of which plan-gate ran.
# shellcheck source=../../plan/scripts/lib.sh
. "$SCRIPT_DIR/../../plan/scripts/lib.sh"

root="$(plan_repo_root)" || exit 1
cd "$root" || plan_die "cannot cd to repo root"

[ $# -ge 1 ] || { printf 'usage: plan-gate <base-ref> [<head-ref>]\n' >&2; exit 1; }
base="$1" head="${2:-HEAD}"

# Resolve both refs before trusting anything derived from them. A typo'd
# base makes `git log` fail, and its error is swallowed below, leaving an
# empty plan list that reads as "nothing to gate" and exits 0 -- a green
# gate over an unexamined range.
# plan: 2026-09-05-route-every-fact-into-one-channel-by-decidability-and-audience.md#F4
for r in "$base" "$head"; do
  git rev-parse --verify --quiet "$r^{commit}" >/dev/null ||
    { echo "BLOCKED: cannot resolve ref '$r'." >&2; exit 1; }
done

# Status checked, stderr not swallowed. Resolving both refs above does
# not make this call safe: it can still fail on a corrupt object, an
# unreadable pack or a shallow clone, and an empty result reads as
# "nothing to gate" -- a green gate over a range nobody examined.
# plan: 2026-09-06-harden-the-workflow-system-against-the-failure-classes-it-exposed.md#F1
if ! plans="$(git log --format='%(trailers:key=Plan,valueonly)' "${base}..${head}" | sed '/^$/d' | sort -u)"; then
  echo "BLOCKED: cannot read commit trailers for ${base}..${head}; refusing to report an unexamined range as clean." >&2
  exit 1
fi

if [ -z "$plans" ]; then
  echo "no 'Plan:' trailers found in ${base}..${head} -- nothing to gate."
  exit 0
fi

fail=0
still_open=0

while IFS= read -r p; do
  [ -n "$p" ] || continue
  rel="$(plan_locate "$p" "$root" 2>/dev/null)" || {
    echo "BLOCKED: commit range cites plan '$p', which cannot be uniquely located under docs/plans/." >&2
    fail=1
    continue
  }

  # The one hard check: an unresolved security finding rated CRITICAL or
  # HIGH must be dealt with (plan-resolve: fixed, accepted with the
  # user's sign-off, or moot) before the range merges. Anything the
  # security agent rated lower, and any finding with no Severity line at
  # all (docs-updater's, hand-written ones), is parkable.
  critical="$(plan_unresolved_critical_findings "$root/$rel")"
  if [ -n "$critical" ]; then
    echo "BLOCKED: $rel has unresolved CRITICAL/HIGH security finding(s) -- resolve with plan-resolve before merging:" >&2
    echo "$critical" >&2
    fail=1
  fi

  # Everything below is information, not enforcement.
  unresolved="$(plan_unresolved_findings "$root/$rel")"
  if [ -n "$unresolved" ] && [ "$unresolved" != "$critical" ]; then
    echo "NOTE: $rel has unresolved (parked) finding(s) -- fine to merge, listed so they aren't forgotten:" >&2
    printf '%s\n' "$unresolved" | grep -Fxv -f <(printf '%s\n' "$critical") >&2 || true
  fi

  case "$rel" in
    docs/plans/done/*|docs/plans/rejected/*) ;;
    *)
      echo "NOTE: $rel is still open (not under done/ or rejected/) at merge time -- plan-move it to done/ if this range's work is actually complete." >&2
      still_open=$((still_open + 1))
      ;;
  esac
done <<<"$plans"

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "plan-gate: blocked. See the BLOCKED line(s) above." >&2
  exit 1
fi
if [ "$still_open" -gt 0 ]; then
  echo "" >&2
fi
echo "plan-gate: no unresolved CRITICAL/HIGH security findings in any cited plan ($(printf '%s\n' "$plans" | grep -c .))."
exit 0
