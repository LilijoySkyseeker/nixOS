#!/usr/bin/env bash
# verify-ladder -- docs/procedures/testing-changes.md's lint gate plus
# the mechanical half of its rung 3 (eval, targeted build). Passing does
# not reach rung 3, which is earned by reading the output. Wired in as a
# hard gate in the `workflow` skill's own step sequence instead of left to
# memory. Hard-blocks on plan-citations, gate-tests, plan-lint over the
# active plan, nixfmt --check, nix flake check, a targeted
# nixos-rebuild build, and statix/deadnix -- but only for *newly introduced* warnings (line falls
# inside the actual diff), never pre-existing debt elsewhere in a touched
# file; linting a whole file over a one-line edit would otherwise block
# on unrelated history. Requires jq for the diff-scoped precision; falls
# back to informational-only if jq is missing.
# Independent of the tabled vm-testing question -- never VM-boots or
# switches anything.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=../../plan/scripts/lib.sh
. "$SCRIPT_DIR/../../plan/scripts/lib.sh"
root="$(plan_repo_root)" || exit 1
cd "$root" || plan_die "cannot cd to repo root"

fail=0
# Untracked included (see plan_worktree_files): a brand-new module was
# obliging review from required-agents while skipping nixfmt/statix/
# deadnix here entirely. Deleted-but-not-yet-committed paths are dropped
# -- the linters below take filenames and would block on a legitimate
# deletion. The targeted-build set further down keeps them, because a
# deleted module still has to rebuild.
changed_nix="$(plan_worktree_files '*.nix' | plan_existing_files)" || {
  echo "BLOCKED: cannot list working-tree changes; refusing to lint an empty set." >&2
  exit 1
}

echo "== plan-citations =="
# Cheap (one awk pass over the working tree's code and docs, tracked and
# untracked), so it runs on every pass rather than only when a plan file
# changed: a citation breaks from the *target* side -- a renamed plan or
# a retyped id -- and that edit need not touch the file doing the citing.
# Called unconditionally: unlike plan-gate, which CI runs from a pinned
# base-branch copy that may predate a sibling, verify-ladder always ships
# from the same checkout as plan-citations. An existence check here could
# only ever fire on a broken checkout, and would hide it behind a pass.
if ! "$SCRIPT_DIR/../../plan/scripts/plan-citations"; then
  echo "BLOCKED: broken plan citation(s) above. Fix the citation, or wrap a deliberate example in the plan-citations ignore markers." >&2
  fail=1
fi

echo "== gate-tests =="
# The gates' own failure-mode tests, run unconditionally for the same
# reason plan-citations is: a gate breaks from the *library* side, so the
# edit that breaks it need not touch the script being tested. ~1.2s, no
# network, scratch repos under TMPDIR.
# plan: 2026-09-06-harden-the-workflow-system-against-the-failure-classes-it-exposed.md#G2
#
# Called directly even though `checks.gate-tests` now runs the same suite.
# That is not a double run: the flake-check step below passes --no-build,
# which nix documents as "Do not build checks" -- it evaluates them and
# stops. Drop this call and nothing runs the suite before a commit.
# plan: 2026-09-07-revise-the-plan-file-schema-state-first-four-frontmatter-fields.md#F46
if ! "$SCRIPT_DIR/../../../../scripts/gate-tests"; then
  echo "BLOCKED: a gate script no longer fails where it must, or no longer passes an honest sequence. See above." >&2
  fail=1
fi

echo "== plan-lint (active plan) =="
# The active plan only. Structural faults it catches -- duplicate or
# non-sequential D/G/F ids, a Progress line citing a heading that does
# not exist -- are what two agents appending findings concurrently
# produce, so the serialization rule in reference.md depends on something
# actually running this.
if active_plan="$(plan_active_plan)"; then
  if ! "$SCRIPT_DIR/../../plan/scripts/plan-lint" "$active_plan"; then
    echo "BLOCKED: the active plan is malformed. See the problems above." >&2
    fail=1
  fi
elif marker_problem="$(plan_active_plan_problem)"; [ -n "$marker_problem" ]; then
  # A marker naming nothing usable is not the same as no marker, and
  # plan_active_plan returns 1 for both. A plan deleted or renamed after
  # plan-new wrote the marker left this pointing at a missing file, and the
  # lint was skipped under a line that reads like a clean pass -- observed,
  # not hypothetical.
  # plan: 2026-09-07-revise-the-plan-file-schema-state-first-four-frontmatter-fields.md#F10
  echo "BLOCKED: $marker_problem. Fix or remove the marker." >&2
  fail=1
else
  echo "(no active plan this session)"
fi

echo "== nixfmt --check =="
if [ -z "$changed_nix" ]; then
  echo "(no changed .nix files)"
elif command -v nixfmt >/dev/null 2>&1; then
  if ! printf '%s\n' "$changed_nix" | xargs -r nixfmt --check; then
    echo "BLOCKED: nixfmt --check failed on the file(s) above. Run 'nixfmt <file>' to fix." >&2
    fail=1
  fi
else
  echo "nixfmt not on PATH -- skipping (expected inside 'nix develop')." >&2
fi

# changed_lines <file> -- one new-file line number per line, for every
# added/modified line relative to HEAD (working tree + staged combined).
changed_lines() {
  git diff -U0 HEAD -- "$1" 2>/dev/null | awk '
    /^@@/ {
      match($0, /\+([0-9]+)(,([0-9]+))?/, m)
      start = m[1] + 0
      count = (m[3] == "" ? 1 : m[3] + 0)
      for (i = 0; i < count; i++) print start + i
    }
  '
}

if [ -z "$changed_nix" ]; then
  echo "== statix / deadnix =="
  echo "(no changed .nix files)"
elif ! command -v jq >/dev/null 2>&1; then
  echo "== statix / deadnix (informational -- jq missing, can't diff-scope precisely) =="
  command -v statix >/dev/null 2>&1 && printf '%s\n' "$changed_nix" | while IFS= read -r f; do statix check "$f" || true; done
  command -v deadnix >/dev/null 2>&1 && printf '%s\n' "$changed_nix" | xargs -r deadnix || true
else
  echo "== statix check (new issues only, blocking) =="
  if command -v statix >/dev/null 2>&1; then
    statix_out="$(mktemp)"
    printf '%s\n' "$changed_nix" | while IFS= read -r f; do
      lines_file="$(mktemp)"
      changed_lines "$f" > "$lines_file"
      statix check --format json "$f" 2>/dev/null \
        | jq -r '.report[]? | .diagnostics[]? | "\(.at.from.line) \(.at.to.line) \(.note)"' \
        | while read -r from to note; do
            for ((l = from; l <= to; l++)); do
              if grep -qx "$l" "$lines_file"; then
                echo "NEW: $f:$from-$to: $note"
                break
              fi
            done
          done
      rm -f "$lines_file"
    done > "$statix_out" 2>&1 || true
    cat "$statix_out"
    [ -s "$statix_out" ] && fail=1
    [ -s "$statix_out" ] || echo "(no new statix issues in the changed lines)"
    rm -f "$statix_out"
  else
    echo "statix not on PATH -- skipping." >&2
  fi

  echo "== deadnix (new issues only, blocking) =="
  if command -v deadnix >/dev/null 2>&1; then
    deadnix_out="$(mktemp)"
    printf '%s\n' "$changed_nix" | while IFS= read -r f; do
      lines_file="$(mktemp)"
      changed_lines "$f" > "$lines_file"
      deadnix --output-format json "$f" 2>/dev/null \
        | jq -r '.results[]? | "\(.line) \(.message)"' \
        | while read -r line rest; do
            if grep -qx "$line" "$lines_file"; then
              echo "NEW: $f:$line: $rest"
            fi
          done
      rm -f "$lines_file"
    done > "$deadnix_out" 2>&1 || true
    cat "$deadnix_out"
    [ -s "$deadnix_out" ] && fail=1
    [ -s "$deadnix_out" ] || echo "(no new deadnix issues in the changed lines)"
    rm -f "$deadnix_out"
  else
    echo "deadnix not on PATH -- skipping." >&2
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo "BLOCKED: new statix/deadnix issue(s) in changed lines. See above." >&2
fi

echo "== nix flake check --no-build =="
if ! nix flake check --no-build; then
  echo "BLOCKED: nix flake check failed. See output above." >&2
  fail=1
fi

# Targeted build: same build-set selection as .githooks/pre-push, but
# against the working tree rather than a push range, since this runs
# mid-session before a commit even exists. Untracked included, same as
# the lint set above -- a brand-new hosts/ or modules/ file must trigger
# a build too, not just linting.
changed_all="$(plan_worktree_files hosts/ modules/ files/ flake.nix flake.lock)" || {
  echo "BLOCKED: cannot list working-tree changes; refusing to skip the targeted build." >&2
  exit 1
}

if [ -n "$changed_all" ]; then
  to_build=""
  # The pathspec above is the only spelling of the trigger set: every
  # listed path is a trigger, and any line outside hosts/ (modules/,
  # files/, flake.*) affects all hosts. Same logic as .githooks/pre-push,
  # deliberately -- the two build gates must not diverge
  # plan: 2026-09-05-route-every-fact-into-one-channel-by-decidability-and-audience.md#F48
  if printf '%s\n' "$changed_all" | grep -qv '^hosts/'; then
    global=1
  else
    global=0
  fi
  for host in $(find hosts -mindepth 1 -maxdepth 1 -type d -printf '%f\n'); do
    if [ "$global" -eq 1 ] || printf '%s\n' "$changed_all" | grep -q "^hosts/${host}/"; then
      to_build="$to_build $host"
    fi
  done
  for host in $to_build; do
    echo "== nixos-rebuild build --flake .#${host} =="
    if ! nixos-rebuild build --flake ".#${host}"; then
      echo "BLOCKED: build failed for host '${host}'. Fix it before committing." >&2
      fail=1
    fi
  done
else
  echo "(no host/module changes -- skipping targeted build)"
fi

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "verify-ladder: one or more checks failed. Fix them before committing." >&2
  exit 1
fi
echo "verify-ladder: all checks passed."
exit 0
