#!/usr/bin/env bash
# required-agents [<base> [<head>]]
# Prints, one per line, which review agents a diff obliges. With no
# arguments, the working tree (including untracked files); with a base
# ref, the merge range, for plan-gate. Read-only; decides nothing about
# whether they actually ran.
#
# The triggers are mechanical on purpose: a trigger an agent has to
# *judge* is a trigger that gets skipped, so the obligation is computed
# from the diff instead.
# plan: 2026-09-05-route-every-fact-into-one-channel-by-decidability-and-audience.md#D7
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=../../plan/scripts/lib.sh
. "$SCRIPT_DIR/../../plan/scripts/lib.sh"

root="$(plan_repo_root)" || exit 1
cd "$root" || plan_die "cannot cd to repo root"

if [ $# -ge 1 ]; then
  # Range mode, for plan-gate. Three-dot: the diff against the merge
  # base, not against wherever the base branch has since moved on to.
  #
  # The exit status is checked, not assumed. A failed `git diff` inside a
  # command substitution leaves `changed` empty, which reads as "no files
  # changed, so no agents obliged" -- turning plan-gate's mandatory
  # dependency into a silent pass. That is the fail-open this whole check
  # exists to close, so it must not reappear here.
  # plan: 2026-09-05-route-every-fact-into-one-channel-by-decidability-and-audience.md#F3
  # core.quotePath=false, and what it does not cover -- see
  # plan_worktree_files
  # plan: 2026-09-05-route-every-fact-into-one-channel-by-decidability-and-audience.md#F42
  if ! changed="$(git -c core.quotePath=false diff --name-only "${1}...${2:-HEAD}")"; then
    plan_die "cannot diff ${1}...${2:-HEAD} -- refusing to report an empty obligation set"
  fi
else
  # Working-tree mode: unstaged + staged + untracked, one definition for
  # all callers -- see plan_worktree_files for why untracked files count.
  changed="$(plan_worktree_files)" ||
    plan_die "cannot list working-tree changes -- refusing to report an empty obligation set"
fi
[ -n "$changed" ] || exit 0

# "is this reviewable code" comes from plan_is_code_path / PLAN_CODE_GLOBS
# rather than a regex here: what obliges review has to be exactly what
# the stamp fingerprint covers
# plan: 2026-09-05-route-every-fact-into-one-channel-by-decidability-and-audience.md#F29
code=0 docs=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  if plan_is_code_path "$f"; then code=1; fi
  # `if`, not `&&` -- a while loop exits with its last body command's
  # status, which is inert here but one refactor from mattering
  # plan: 2026-09-05-route-every-fact-into-one-channel-by-decidability-and-audience.md#F32
  if plan_is_doc_path "$f"; then docs=1; fi
done <<<"$changed"

# An array, not a space-joined string: iterating a string means unquoted
# expansion, and that adds pathname expansion on any member containing a
# glob character -- latent while every name is a glob-free literal, but a
# hazard the array form does not have at all.
# plan: 2026-09-05-route-every-fact-into-one-channel-by-decidability-and-audience.md#F65
obliged=()
# /simplify and security review code, per PLAN_CODE_GLOBS -- see the
# rationale there for why the set is wider than Nix.
[ "$code" = 1 ] && obliged+=("/simplify" "security")

# docs-updater keys off code *or* docs: a code change can invalidate a doc
# without touching that doc, which is exactly the drift it exists to
# catch, so "only when a .md changed" would miss the case that matters
# most. Narrowing this to the docs a given file is actually named by needs
# a doc-to-code index that does not exist yet.
{ [ "$code" = 1 ] || [ "$docs" = 1 ]; } && obliged+=("docs-updater")

# spec-check reads the active plan's Decisions as the spec, which makes it
# a working-tree notion -- the active-plan marker describes a live
# session, not a merge range, so range mode cannot answer the question at
# all.
if [ $# -eq 0 ] && plan="$(plan_active_plan)"; then
  plan_has_heading "$plan" 'D[0-9]+' && obliged+=("spec-check")
fi

# Emitted in PLAN_AGENT_ORDER, never in the order the tests above happen
# to run: an agent reading this output top-to-bottom must get a sequence
# it can actually execute, and running security before docs-updater
# leaves security's stamp stale by construction.
emitted=()
for a in "${PLAN_AGENT_ORDER[@]}"; do
  if plan_in_list "$a" "${obliged[@]}"; then
    echo "$a"
    emitted+=("$a")
  fi
done

# An obliged agent absent from PLAN_AGENT_ORDER would simply not be
# printed: no error, exit 0, and plan-gate then obliges no stamp for it.
# One renamed entry silently degrades the whole gate to a no-op behind a
# green check, so the mismatch is fatal rather than filtered.
# plan: 2026-09-05-route-every-fact-into-one-channel-by-decidability-and-audience.md#F47
for a in "${obliged[@]}"; do
  plan_in_list "$a" "${emitted[@]}" ||
    plan_die "'$a' is obliged but missing from PLAN_AGENT_ORDER -- refusing to report an incomplete set"
done
