#!/usr/bin/env bash
# required-agents [<base> [<head>]]
# Prints, one per line and in run order, which review agents a diff calls
# for: the working tree (including untracked files) by default, or the
# merge range <base>...<head>. Read-only and advisory. Fails rather than
# printing an empty set when a git call fails.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=lib.sh
. "$SCRIPT_DIR/lib.sh"

root="$(wf_repo_root)" || exit 1
cd "$root" || wf_die "cannot cd to repo root"

if [ $# -ge 1 ]; then
  if ! changed="$(git -c core.quotePath=false diff --name-only "${1}...${2:-HEAD}")"; then
    wf_die "cannot diff ${1}...${2:-HEAD} -- refusing to report an empty obligation set"
  fi
else
  changed="$(wf_worktree_files)" ||
    wf_die "cannot list working-tree changes -- refusing to report an empty obligation set"
fi
[ -n "$changed" ] || exit 0

code=0 docs=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  if wf_is_code_path "$f"; then code=1; fi
  if wf_is_doc_path "$f"; then docs=1; fi
done <<<"$changed"

obliged=()
[ "$code" = 1 ] && obliged+=("/simplify" "security")
# code too: a code change can stale a doc it never touches
{ [ "$code" = 1 ] || [ "$docs" = 1 ]; } && obliged+=("docs-updater")

emitted=()
for a in "${WF_AGENT_ORDER[@]}"; do
  if wf_in_list "$a" "${obliged[@]}"; then
    echo "$a"
    emitted+=("$a")
  fi
done

# an agent missing from the order would otherwise vanish silently
for a in "${obliged[@]}"; do
  wf_in_list "$a" "${emitted[@]}" ||
    wf_die "'$a' is obliged but missing from WF_AGENT_ORDER -- refusing to report an incomplete set"
done
