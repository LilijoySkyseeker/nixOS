#!/usr/bin/env bash
# plan-lint <path> -- structural validator, read-only. Checks frontmatter
# completeness, that status matches folder, that every required section is
# present, that D/G/F headings are sequential from 1 with no gaps or
# duplicates, and that every id a Progress checkbox cites actually exists
# as a heading. Prints every problem found; exits non-zero if any exist.
# Resolves G5 in 2026-08-27-known-weak-points-in-the-plan-file-and-workflow-sy.md
# -- nothing previously checked this mechanically; every existing plan file
# was correct by construction or careful hand-authorship only.
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=lib.sh
. "$SCRIPT_DIR/lib.sh"

[ $# -eq 1 ] || { printf 'usage: plan-lint <path-or-filename>\n' >&2; exit 1; }
root="$(plan_repo_root)"
rel="$(plan_locate "$1" "$root")"
file="$root/$rel"
problems=0
report() { printf '%s\n' "$1"; problems=$((problems + 1)); }

# one pass over the frontmatter, one over the headings -- every value, every
# key-present answer and every heading line comes from these two reads
declare -A fm_val=() fm_seen=()
while IFS=$'\t' read -r fkey fval; do
  [ -n "$fkey" ] || continue
  fm_seen["$fkey"]=1
  fm_val["$fkey"]="$fval"
done < <(plan_frontmatter "$file")

# Whole-line and fence-aware: a substring match passed on a prose mention of
# a heading name mid-sentence, and a fence-blind one counts an example
# template quoted inside a section.
# plan: 2026-09-06-harden-the-workflow-system-against-the-failure-classes-it-exposed.md#G1
# plan: 2026-09-07-revise-the-plan-file-schema-state-first-four-frontmatter-fields.md#F13
declare -A sec_line=()
while IFS=$'\t' read -r sline stext; do
  [ -n "$stext" ] || continue
  [ -n "${sec_line[$stext]:-}" ] || sec_line["$stext"]="$sline"
done < <(plan_headings "$file")

for key in "${PLAN_CORE_FIELDS[@]}"; do
  [ -n "${fm_val[$key]:-}" ] || report "frontmatter missing '$key:'"
done

folder="$(basename "$(dirname "$rel")")"
status="${fm_val[status]:-}"
[ "$status" = "$folder" ] || report "frontmatter status '$status' does not match folder '$folder'"

# The manifest, not the file's own `frozen:` field, decides. The field is
# self-declared -- a todo/ plan asserting `frozen: true` would otherwise
# switch off every rule below for itself -- while the manifest is written
# only by plan-freeze and is what .githooks/pre-commit enforces. Reported
# when the two disagree, because either direction is a plan in a state no
# script put it in.
# plan: 2026-09-07-revise-the-plan-file-schema-state-first-four-frontmatter-fields.md#F11
frozen_field="${fm_val[frozen]:-}"
if plan_manifest_frozen "$root" "$rel"; then
  frozen=1
  [ "$frozen_field" = "true" ] ||
    report "frontmatter says frozen '$frozen_field' but $PLAN_CHECKSUMS_RELPATH records this file as frozen"
else
  frozen=0
  [ "$frozen_field" != "true" ] ||
    report "frontmatter says 'frozen: true' but $PLAN_CHECKSUMS_RELPATH has no entry -- only plan-freeze may freeze a plan"
fi

# schema-era rules, sections and D4 fields alike, run only where the file can
# still be edited to satisfy them
# plan: 2026-09-07-revise-the-plan-file-schema-state-first-four-frontmatter-fields.md#G5
if [ "$frozen" -eq 0 ]; then
  for section in "${PLAN_SECTIONS[@]}"; do
    [ -n "${sec_line[$section]:-}" ] || report "missing required section '$section'"
  done

  prev_line=0 prev_name=""
  for section in "${PLAN_SECTIONS[@]}"; do
    line="${sec_line[$section]:-}"
    [ -n "$line" ] || continue
    [ "$line" -gt "$prev_line" ] ||
      report "section '$section' appears before '$prev_name' -- required order is: ${PLAN_SECTIONS[*]}"
    prev_line="$line" prev_name="$section"
  done

  for key in "${PLAN_SCHEMA_FIELDS[@]}"; do
    [ -n "${fm_seen[$key]:-}" ] ||
      report "frontmatter missing '$key:' -- added by the D4 schema revision"
  done

  # key-to-vocabulary mapping is lib.sh's, so a new vocabulary field needs no
  # edit here
  for key in "${PLAN_VOCAB_FIELDS[@]}"; do
    [ -n "${fm_seen[$key]:-}" ] || continue
    vocab_name="${PLAN_FIELD_VOCAB[$key]:-}"
    if [ -z "$vocab_name" ]; then
      report "no vocabulary is defined for '$key' -- add it to PLAN_FIELD_VOCAB"
      continue
    fi
    declare -n allowed="$vocab_name"
    value="${fm_val[$key]:-}"
    if [ -z "$value" ]; then
      report "frontmatter '$key:' is empty -- one of: ${allowed[*]}"
    elif ! plan_in_list "$value" "${allowed[@]}"; then
      report "frontmatter $key '$value' is not one of: ${allowed[*]}"
    fi
    unset -n allowed
  done

  # shape only: existence is plan-citations' job, the path form is the one
  # thing its resolver cannot catch
  # plan: 2026-09-07-revise-the-plan-file-schema-state-first-four-frontmatter-fields.md#G7
  for key in "${PLAN_REF_FIELDS[@]}"; do
    while IFS= read -r ref; do
      [ -n "$ref" ] || continue
      case "$ref" in
        */*|*..*)
          report "frontmatter $key cites '$ref' -- must be a bare filename, never a path"
          continue ;;
      esac
      # The canonical <date>-<slug>.md shape, which is also the only form
      # plan-citations recognises. Anything else -- a capitalised name, a
      # bare slug, a note to self -- resolves for neither tool and would sit
      # there looking checked.
      # plan: 2026-09-07-revise-the-plan-file-schema-state-first-four-frontmatter-fields.md#F14
      [[ "$ref" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*\.md$ ]] ||
        report "frontmatter $key cites '$ref' -- not a plan filename (<date>-<slug>.md)"
    done < <(plan_field_refs "$file" "$key")
  done
fi

for type in D G F; do
  raw="$(grep -oE "^### ${type}[0-9]+" "$file" | grep -oE '[0-9]+')"
  [ -z "$raw" ] && continue
  dupes="$(printf '%s\n' "$raw" | sort -n | uniq -d)"
  [ -n "$dupes" ] && report "duplicate ${type} id(s): $(printf '%s' "$dupes" | tr '\n' ' ')"
  ids="$(printf '%s\n' "$raw" | sort -nu)"
  expected=1
  while IFS= read -r n; do
    [ "$n" -eq "$expected" ] || report "${type} headings not sequential from 1: expected ${type}${expected}, found ${type}${n}"
    expected=$((expected + 1))
  done <<<"$ids"
done

# Only the ID immediately following the checkbox counts as a local
# citation to validate -- a bare "- [ ] D1 ..." / "- [ ] G2 ..." is this
# file's own convention for a locally-tracked item (see reference.md's
# worked example). An ID appearing later in a bullet's prose is routinely
# a cross-reference to a *different* plan file's id (e.g. "resolve
# G5/G20 in <other-file>") and isn't meant to resolve locally -- treating
# it as a citation produced false positives on this very file's own
# Progress section during development.
while IFS= read -r cited; do
  [ -n "$cited" ] || continue
  plan_has_heading "$file" "$cited" || report "Progress cites '${cited}' but no '### ${cited}' heading exists"
done < <(grep -oE '^- \[[ xX]\] [DGF][0-9]+\b' "$file" | grep -oE '[DGF][0-9]+' | sort -u)

if [ "$problems" -gt 0 ]; then
  plan_note "$rel: $problems problem(s) found."
  exit 1
fi
echo "$rel: OK"
