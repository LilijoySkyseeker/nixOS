#!/usr/bin/env bash
# plan-move <path-or-filename> <in-progress|done>
# Moves a plan between folders. No repo-wide citation rewrite is needed --
# citations are bare-filename, which never encodes the folder. Moving to
# `done` runs the close-out gates (no unresolved decision or finding,
# non-empty ## State declaring a verification rung), then auto-freezes.
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=lib.sh
. "$SCRIPT_DIR/lib.sh"

[ $# -eq 2 ] || { printf 'usage: plan-move <path-or-filename> <in-progress|done>\n' >&2; exit 1; }
arg="$1" target="$2"
case "$target" in
  in-progress|done) ;;
  *) plan_die "target must be 'in-progress' or 'done', got '$target'." ;;
esac

root="$(plan_repo_root)" || exit 1
rel="$(plan_locate "$arg" "$root")" || exit 1
plan_require_not_frozen "$root/$rel"

base="$(basename "$rel")"
current_dir="$(dirname "$rel")"
new_rel="docs/plans/${target}/${base}"

[ "$current_dir" = "docs/plans/${target}" ] && plan_die "$rel is already in docs/plans/${target}/."

if [ "$target" = "done" ]; then
  unresolved="$(plan_unresolved_decisions "$root/$rel")"
  if [ -n "$unresolved" ]; then
    plan_die "cannot move to done/ -- unresolved decisions (must be ANSWERED, or DEFERRED with a plan-carry):
$unresolved"
  fi

  unresolved_f="$(plan_unresolved_findings "$root/$rel")"
  if [ -n "$unresolved_f" ]; then
    plan_die "cannot move to done/ -- unresolved findings (must be FIXED, ACCEPTED, or MOOT -- use plan-resolve):
$unresolved_f"
  fi

  state_problem="$(plan_state_problem "$root/$rel")"
  [ -n "$state_problem" ] && plan_die "cannot move to done/ -- $state_problem"

  rung_problem="$(plan_rung_problem "$root/$rel")"
  [ -n "$rung_problem" ] && plan_die "cannot move to done/ -- $rung_problem"
fi

# Checked, for the same reason plan-reject's is: an unchecked mv left the
# plan where it was while the script went on to rewrite the frontmatter of a
# path that does not exist, mark it touched, and -- for `done` -- exec
# plan-freeze over it, exiting 0 the whole way.
# plan: 2026-09-07-revise-the-plan-file-schema-state-first-four-frontmatter-fields.md#F47
git -C "$root" mv "$rel" "$new_rel" ||
  plan_die "cannot move $rel to $new_rel -- nothing else was done; re-run once the move can succeed."
plan_set_field "$root/$new_rel" status "$target"
plan_mark_touched "$root" "$new_rel"

# Checked, both arms: the move has already happened by this point, so a
# failed stage leaves the plan in its new folder and out of the index while
# the script says it succeeded -- and for `done` it then execs plan-freeze,
# which records a checksum for a file the commit will not carry.
# plan: 2026-09-07-revise-the-plan-file-schema-state-first-four-frontmatter-fields.md#F47
git -C "$root" add "$new_rel" ||
  plan_die "$rel was moved to $new_rel but could not be staged; stage it before committing."
if [ "$target" = "done" ]; then
  exec "$SCRIPT_DIR/plan-freeze" "$new_rel"
else
  echo "$new_rel"
fi
