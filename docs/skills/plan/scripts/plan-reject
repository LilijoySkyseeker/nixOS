#!/usr/bin/env bash
# plan-reject <path> "<reason>"
# Moves a todo/ or in-progress/ plan to docs/plans/rejected/ and freezes it
# permanently -- for work that was started and abandoned, or superseded by
# a different approach. Unlike plan-move ... done, this does NOT require
# every decision to be resolved: abandoning the work legitimately moots
# open questions, rather than obligating them to be answered first. A
# reason is mandatory instead, appended as a dated marker (append-only,
# same as everything else) -- if superseded by another plan, cite it by
# bare filename in the reason text.
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=lib.sh
. "$SCRIPT_DIR/lib.sh"

[ $# -eq 2 ] || { printf 'usage: plan-reject <path> "<reason>"\n' >&2; exit 1; }
arg="$1" reason="$2"
[ -n "$reason" ] || plan_die "a reason is required -- why was this abandoned, or what superseded it?"

root="$(plan_repo_root)"
rel="$(plan_locate "$arg" "$root")"
plan_require_not_frozen "$root/$rel"

case "$(dirname "$rel")" in
  docs/plans/todo | docs/plans/in-progress) ;;
  *) plan_die "$rel is not in todo/ or in-progress/ -- nothing else is eligible for rejection." ;;
esac

# The second door to freeze: rejected/ is as permanent as done/, so it lints
# too, even though it waives the decision and finding gates.
# Before the marker and the move, not after: plan_die on a refusal would
# otherwise leave the plan sitting in rejected/, stamped rejected and
# unfrozen -- a state no script put it in and none clears.
# plan: 2026-09-07-revise-the-plan-file-schema-state-first-four-frontmatter-fields.md#G10
# plan: 2026-09-07-revise-the-plan-file-schema-state-first-four-frontmatter-fields.md#F31
if ! lint_out="$("$SCRIPT_DIR/plan-lint" "$rel" 2>&1)"; then
  plan_die "cannot reject -- $rel is malformed, and freezing makes that permanent:
$lint_out"
fi

today="$(plan_today)"
printf '\n**REJECTED %s:** %s\n' "$today" "$reason" >> "$root/$rel"

base="$(basename "$rel")"
new_rel="docs/plans/rejected/${base}"
git -C "$root" mv "$rel" "$new_rel"
plan_set_field "$root/$new_rel" status rejected

plan_do_freeze "$root" "$new_rel"
plan_note "$new_rel rejected and frozen."
echo "$new_rel"
