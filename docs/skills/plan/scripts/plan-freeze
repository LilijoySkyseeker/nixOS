#!/usr/bin/env bash
# plan-freeze <path-or-filename>
# Marks a docs/plans/done/ file frozen: true, permanently. Normally called
# by plan-move ... done, but safe to call directly (e.g. during migration)
# once the file already sits under docs/plans/done/.
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=lib.sh
. "$SCRIPT_DIR/lib.sh"

[ $# -eq 1 ] || { printf 'usage: plan-freeze <path-or-filename>\n' >&2; exit 1; }
root="$(plan_repo_root)" || exit 1
rel="$(plan_locate "$1" "$root")" || exit 1

case "$rel" in
  docs/plans/done/*) ;;
  *) plan_die "$rel is not under docs/plans/done/ -- use plan-move to move it there first." ;;
esac

# The manifest, not the file's own `frozen:` field. Flipping a done/ plan to
# `frozen: false`, editing it and re-running plan-freeze would otherwise
# rewrite the manifest to the tampered hash -- the freeze evidence
# re-blessing whatever it was pointed at.
# plan: 2026-09-07-revise-the-plan-file-schema-state-first-four-frontmatter-fields.md#F34
plan_manifest_frozen "$root" "$rel" &&
  plan_die "$rel is already frozen ($PLAN_CHECKSUMS_RELPATH records it). Its checksum is the evidence it has not changed; re-freezing would replace that evidence."

unresolved="$(plan_unresolved_decisions "$root/$rel")"
if [ -n "$unresolved" ]; then
  plan_die "cannot freeze -- unresolved decisions (must be ANSWERED, or DEFERRED with a plan-carry):
$unresolved"
fi

unresolved_f="$(plan_unresolved_findings "$root/$rel")"
if [ -n "$unresolved_f" ]; then
  plan_die "cannot freeze -- unresolved findings (must be FIXED, ACCEPTED, or MOOT -- use plan-resolve):
$unresolved_f"
fi

state_problem="$(plan_state_problem "$root/$rel")"
[ -n "$state_problem" ] && plan_die "cannot freeze -- $state_problem"

rung_problem="$(plan_rung_problem "$root/$rel")"
[ -n "$rung_problem" ] && plan_die "cannot freeze -- $rung_problem"

# structure, checked at the one moment it stops being fixable; run before
# the freeze, so the file is still judged as editable
# plan: 2026-09-07-revise-the-plan-file-schema-state-first-four-frontmatter-fields.md#D4
if ! lint_out="$("$SCRIPT_DIR/plan-lint" "$rel" 2>&1)"; then
  plan_die "cannot freeze -- $rel is malformed, and freezing makes that permanent:
$lint_out"
fi

plan_do_freeze "$root" "$rel"
plan_note "$rel frozen."
echo "$rel"
