#!/usr/bin/env bash
# plan-freeze <path-or-filename>
# Marks a docs/plans/done/ file frozen: true, permanently. Normally called
# by plan-move ... done, but safe to call directly (e.g. during migration)
# once the file already sits under docs/plans/done/.
set -u
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=lib.sh
. "$SCRIPT_DIR/lib.sh"

[ $# -eq 1 ] || { printf 'usage: plan-freeze <path-or-filename>\n' >&2; exit 1; }
root="$(plan_repo_root)" || exit 1
rel="$(plan_locate "$1" "$root")" || exit 1

case "$rel" in
  docs/plans/done/*) ;;
  *) plan_die "$rel is not under docs/plans/done/ -- use plan-move to move it there first." ;;
esac

# Hard gates and warnings, per the dismantle plan's refined D5: an honest
# State with a rung declaration and no unresolved CRITICAL/HIGH security
# finding are still required -- everything else warns and proceeds, because
# blocking on full drainage is what livelocked the old system.
# plan: 2026-09-09-dismantle-the-blocking-gate-tier-and-keep-the-plan-corpus.md#D5
critical_f="$(plan_unresolved_critical_findings "$root/$rel")"
if [ -n "$critical_f" ]; then
  plan_die "cannot freeze -- unresolved CRITICAL/HIGH security finding(s) (must be FIXED, ACCEPTED with the user's sign-off, or MOOT -- use plan-resolve):
$critical_f"
fi

state_problem="$(plan_state_problem "$root/$rel")"
[ -n "$state_problem" ] && plan_die "cannot freeze -- $state_problem"

rung_problem="$(plan_rung_problem "$root/$rel")"
[ -n "$rung_problem" ] && plan_die "cannot freeze -- $rung_problem"

unresolved="$(plan_unresolved_decisions "$root/$rel")"
if [ -n "$unresolved" ]; then
  plan_note "WARNING: freezing with unresolved decision(s) -- consider plan-decide or plan-carry first, since a frozen file can never resolve them:
$unresolved"
fi

unresolved_f="$(plan_unresolved_findings "$root/$rel")"
if [ -n "$unresolved_f" ]; then
  plan_note "WARNING: freezing with unresolved (parked) finding(s) -- they stay on record here but can never be marked resolved:
$unresolved_f"
fi

# No lint call here: it is advisory now, verify-ladder already warns on it
# before every commit, and an advisory subprocess inside a write-path gate
# would make its git failures look like the gate's own.

plan_do_freeze "$root" "$rel"
plan_note "$rel frozen."
echo "$rel"
